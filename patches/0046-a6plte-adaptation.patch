+	bool ok = timing && horizontal && vertical && color && timings && colors;
+
+	if (ok) {
+		ok = a6_fb_number(color, "ID", A6PLTE_FB_COLOR_ID) &&
+		    a6_fb_number(color, "PixelEncoding", 0) &&
+		    a6_fb_number(color, "Depth", 8) &&
+		    a6_fb_number(color, "Colorimetry", 1) &&
+		    a6_fb_number(color, "EOTF", 1) &&
+		    a6_fb_number(color, "DynamicRange", 0) &&
+		    a6_fb_number(color, "Score", 1) &&
+		    color->setObject("IsVirtual", kOSBooleanFalse) &&
+		    colors->setObject(color) &&
+		    a6_fb_number(horizontal, "Active", fWidth) &&
+		    a6_fb_number(horizontal, "Total", fWidth) &&
+		    a6_fb_number(horizontal, "SyncRate", rate) &&
+		    a6_fb_number(horizontal, "PreciseSyncRate", rate) &&
+		    a6_fb_number(vertical, "Active", fHeight) &&
+		    a6_fb_number(vertical, "Total", fHeight) &&
+		    a6_fb_number(vertical, "SyncRate", rate) &&
+		    a6_fb_number(vertical, "PreciseSyncRate", rate) &&
+		    a6_fb_number(timing, "ID", A6PLTE_FB_TIMING_ID) &&
+		    a6_fb_number(timing, "Score", 1) &&
+		    timing->setObject("IsVirtual", kOSBooleanFalse) &&
+		    timing->setObject("IsOverscanned", kOSBooleanFalse) &&
+		    timing->setObject("HorizontalAttributes", horizontal) &&
+		    timing->setObject("VerticalAttributes", vertical) &&
+		    timing->setObject("ColorModes", colors) &&
+		    timings->setObject(timing);
+	}
+	/* Publish both before registerService, or expose no partial mode. */
+	if (ok) ok = setProperty("TimingElements", timings) && setProperty("ColorElements", colors);
+	if (!ok) {
+		removeProperty("TimingElements");
+		removeProperty("ColorElements");
+	}
+	OSSafeReleaseNULL(timings);
+	OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(timing);
+	OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical);
+	OSSafeReleaseNULL(color);
+	return ok;
+}
