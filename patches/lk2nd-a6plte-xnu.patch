diff --git i/platform/msm_shared/dev_tree.c w/platform/msm_shared/dev_tree.c
index 86757c0..a160425 100644
--- i/platform/msm_shared/dev_tree.c
+++ w/platform/msm_shared/dev_tree.c
@@ -2096,6 +2096,35 @@ static void dev_tree_update_memory_node(uint32_t offset)
 	mem_node.size_cell_size = 1;
 }
 
+/*
+ * Linux DTs conventionally name the node memory@<base>.  Older LK code used
+ * the abbreviated /memory path, which rejects those DTs before it can fill
+ * the real RAM map from SMEM.  Keep the old path first and fall back to the
+ * standard device_type property.
+ */
+static int dev_tree_find_memory_node(const void *fdt)
+{
+	int node;
+	int depth;
+	int len;
+	const char *type;
+
+	node = fdt_path_offset(fdt, "/memory");
+	if (node >= 0)
+		return node;
+
+	depth = 0;
+	for (node = fdt_next_node(fdt, -1, &depth);
+	     node >= 0;
+	     node = fdt_next_node(fdt, node, &depth)) {
+		type = fdt_getprop(fdt, node, "device_type", &len);
+		if (type && len == 7 && !memcmp(type, "memory\0", 7))
+			return node;
+	}
+
+	return -FDT_ERR_NOTFOUND;
+}
+
 /* Function to add the subsequent RAM partition info to the device tree. */
 int dev_tree_add_mem_info(void *fdt, uint32_t offset, uint64_t addr, uint64_t size)
 {
