diff --git c/bsd/kern/kern_descrip.c w/bsd/kern/kern_descrip.c
index 13b08b5..4755afb 100644
--- c/bsd/kern/kern_descrip.c
+++ w/bsd/kern/kern_descrip.c
@@ -2733,6 +2733,12 @@ outdrop:
 int
 sys_fcntl_nocancel(proc_t p, struct fcntl_nocancel_args *uap, int32_t *retval)
 {
+#if A6PLTE
