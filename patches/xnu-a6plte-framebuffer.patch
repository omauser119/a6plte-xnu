new file mode 100644
index 0000000..f7a48ec
--- /dev/null
+++ w/bsd/dev/a6plte/storage.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef A6PLTE_STORAGE_H
+#define A6PLTE_STORAGE_H
+#include <stdint.h>
+#include <stddef.h>
+
+enum { A6_IO_OK, A6_IO_INVALID, A6_IO_ERROR, A6_IO_TIMEOUT,
+       A6_IO_READONLY, A6_IO_GPT, A6_IO_OFFLINE };
+#define A6_SECTOR_SIZE 512u
+struct a6_blockdev {
+    void *cookie;
+    uint64_t blocks;
+    int (*read)(void *, uint64_t, uint32_t, void *);
