+};
+
+static uint64_t rotate(uint64_t x,unsigned n) { return x>>n | x<<(64-n); }
+static uint64_t load64(const uint8_t *p) {
+    uint64_t x=0;for (unsigned i=0;i<8;++i) x=x<<8 | p[i];return x;
+}
+static void store64(uint8_t *p,uint64_t x) {
+    for (unsigned i=0;i<8;++i) { p[7-i]=(uint8_t)x;x>>=8; }
+}
+static void erase(void *p,size_t n) { volatile uint8_t *b=p;while (n--) *b++=0; }
+void a6_sha512_compress(uint64_t state[8],size_t blocks,const void *data) {
+    const uint8_t *p=data;
+    while (blocks--) {
+        uint64_t w[80];
+        for (unsigned i=0;i<16;++i) w[i]=load64(p+8*i);
+        for (unsigned i=16;i<80;++i) {
+            uint64_t a=w[i-15],b=w[i-2];
+            w[i]=w[i-16]+(rotate(a,1)^rotate(a,8)^(a>>7))+w[i-7]+(rotate(b,19)^rotate(b,61)^(b>>6));
+        }
+        uint64_t a=state[0],b=state[1],c=state[2],d=state[3],e=state[4],f=state[5],g=state[6],h=state[7];
+        for (unsigned i=0;i<80;++i) {
+            uint64_t t=h+(rotate(e,14)^rotate(e,18)^rotate(e,41))+((e&f)^(~e&g))+round_constants[i]+w[i];
+            uint64_t u=(rotate(a,28)^rotate(a,34)^rotate(a,39))+((a&b)^(a&c)^(b&c));
+            h=g;g=f;f=e;e=d+t;d=c;c=b;b=a;a=t+u;
+        }
+        state[0]+=a;state[1]+=b;state[2]+=c;state[3]+=d;
+        state[4]+=e;state[5]+=f;state[6]+=g;state[7]+=h;
+        erase(w,sizeof(w));p+=128;
+    }
+}
+void a6_sha512_init(struct a6_sha512 *ctx,unsigned output_bytes) {
+    erase(ctx,sizeof(*ctx));
+    const uint64_t *iv=output_bytes==48?a6_sha384_iv:a6_sha512_iv;
+    for (unsigned i=0;i<8;++i) ctx->state[i]=iv[i];
+}
+void a6_sha512_update(struct a6_sha512 *ctx,const void *data,size_t length) {
+    const uint8_t *p=data;
+    while (length) {
+        size_t take=128-ctx->used;if (take>length) take=length;
+        for (size_t i=0;i<take;++i) ctx->buffer[ctx->used+i]=p[i];
+        ctx->used+=(uint32_t)take;p+=take;length-=take;
+        if (ctx->used==128) {
+            a6_sha512_compress(ctx->state,1,ctx->buffer);ctx->bits+=1024;ctx->used=0;
+        }
+    }
+}
+void a6_sha512_final(struct a6_sha512 *ctx,void *output,unsigned output_bytes) {
+    uint8_t *out=output;unsigned n=ctx->used;
+    uint64_t bits=ctx->bits+(uint64_t)n*8;
+    ctx->buffer[n++]=0x80;
+    if (n>112) {
+        while (n<128) ctx->buffer[n++]=0;
+        a6_sha512_compress(ctx->state,1,ctx->buffer);n=0;
+    }
+    while (n<120) ctx->buffer[n++]=0;
+    store64(ctx->buffer+120,bits);
+    a6_sha512_compress(ctx->state,1,ctx->buffer);
+    for (unsigned i=0;i<output_bytes/8;++i) store64(out+8*i,ctx->state[i]);
+    erase(ctx,sizeof(*ctx));
+}
diff --git c/libkern/crypto/a6plte_sha512.h w/libkern/crypto/a6plte_sha512.h
new file mode 100644
index 0000000..cf58b86
--- /dev/null
+++ w/libkern/crypto/a6plte_sha512.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef A6PLTE_SHA512_H
+#define A6PLTE_SHA512_H
+#include <stdint.h>
+#include <stddef.h>
+/* Layout matches 8796's legacy ccdigest context, including its bit counter. */
+struct a6_sha512 { uint64_t bits, state[8]; uint8_t buffer[128]; uint32_t used; };
+extern const uint64_t a6_sha512_iv[8], a6_sha384_iv[8];
+void a6_sha512_init(struct a6_sha512 *, unsigned output_bytes);
+void a6_sha512_compress(uint64_t state[8], size_t blocks, const void *data);
+void a6_sha512_update(struct a6_sha512 *, const void *, size_t);
+void a6_sha512_final(struct a6_sha512 *, void *, unsigned output_bytes);
+struct ccdigest_info;
+extern const struct ccdigest_info a6_sha384_di;
+#endif
diff --git c/libkern/crypto/a6plte_sha512_digest.c w/libkern/crypto/a6plte_sha512_digest.c
new file mode 100644
index 0000000..a72df5e
--- /dev/null
+++ w/libkern/crypto/a6plte_sha512_digest.c
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Bind the scalar implementation to the native 8796 ccdigest ABI. */
+#include <corecrypto/ccdigest.h>
+#include <corecrypto/ccsha2.h>
+#include <libkern/crypto/sha2.h>
+#include "a6plte_sha512.h"
+_Static_assert(sizeof(struct a6_sha512)==sizeof(SHA512_CTX), "SHA-512 context ABI size");
+_Static_assert(offsetof(struct a6_sha512,state)==sizeof(uint64_t), "Digest state ABI");
+_Static_assert(offsetof(struct a6_sha512,buffer)==sizeof(uint64_t)+CCSHA512_STATE_SIZE, "Digest buffer ABI");
+_Static_assert(offsetof(struct a6_sha512,used)==sizeof(uint64_t)+CCSHA512_STATE_SIZE+CCSHA512_BLOCK_SIZE, "Digest count ABI");
+static void compress(ccdigest_state_t state,size_t blocks,const void *data) {
+    a6_sha512_compress(ccdigest_u64(state),blocks,data);
+}
+static void final(const struct ccdigest_info *di,ccdigest_ctx_t ctx,unsigned char *output) {
+    a6_sha512_final((void *)ctx,output,(unsigned)di->output_size);
+}
+const struct ccdigest_info ccsha512_ltc_di={
+    .output_size=64,.state_size=64,.block_size=128,
+    .oid_size=11,.oid=CC_DIGEST_OID_SHA512,.initial_state=a6_sha512_iv,
+    .compress=compress,.final=final,.impl=CC_IMPL_SHA512_LTC,
+};
+const struct ccdigest_info a6_sha384_di={
+    .output_size=48,.state_size=64,.block_size=128,
+    .oid_size=11,.oid=CC_DIGEST_OID_SHA384,.initial_state=a6_sha384_iv,
+    .compress=compress,.final=final,.impl=CC_IMPL_SHA512_LTC,
+};
