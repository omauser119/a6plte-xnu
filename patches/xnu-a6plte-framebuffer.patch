+#include "a6plte_kmem_rng.h"
+_Static_assert(sizeof(struct a6_kmem_rng) <= CRYPTO_RANDOM_MAX_CTX_SIZE,
+    "A6PLTE kmem random context exceeds XNU's ABI limit");
+#endif
+
 int
 cc_rand_generate(void *out, size_t outlen)
 {
 	struct ccrng_state *rng_state = NULL;
 	int error = -1;
 
+#if defined(A6PLTE)
+	if (!g_crypto_funcs) {
+		uint8_t *bytes = out;
+		while (outlen) {
+			u_int n = outlen > UINT32_MAX ? UINT32_MAX : (u_int)outlen;
+			read_random(bytes, n);
+			bytes += n;
+			outlen -= n;
+		}
+		return 0;
+	}
+#endif
+
 	if (g_crypto_funcs) {
 		rng_state = g_crypto_funcs->ccrng_fn(&error);
 		if (rng_state != NULL) {
@@ -58,7 +79,13 @@ crypto_random_generate(
 	void *random,
 	size_t random_size)
 {
+#if defined(A6PLTE)
+	/* Kmem handles keep this board representation even if corecrypto is
+	 * registered later. Generation cannot acquire the global RNG's lock. */
+	a6_kmem_rng_generate(ctx, random, random_size);
+#else
 	g_crypto_funcs->random_generate_fn(ctx, random, random_size);
+#endif
 }
 
 void
@@ -67,18 +94,35 @@ crypto_random_uniform(
 	uint64_t bound,
 	uint64_t *random)
 {
+#if defined(A6PLTE)
+	if (a6_kmem_rng_uniform(ctx, bound, random)) {
+		panic("A6PLTE kmem random: zero bound");
+	}
+#else
 	g_crypto_funcs->random_uniform_fn(ctx, bound, random);
+#endif
 }
 
 size_t
 crypto_random_kmem_ctx_size(void)
 {
+#if defined(A6PLTE)
+	return sizeof(struct a6_kmem_rng);
+#else
 	return g_crypto_funcs->random_kmem_ctx_size_fn();
+#endif
 }
 
 void
 crypto_random_kmem_init(
 	crypto_random_ctx_t ctx)
 {
+#if defined(A6PLTE)
+	uint8_t seed[44];
+	read_random(seed, sizeof(seed));
+	a6_kmem_rng_init(ctx, seed);
+	cc_clear(sizeof(seed), seed);
+#else
 	g_crypto_funcs->random_kmem_init_fn(ctx);
+#endif
 }
