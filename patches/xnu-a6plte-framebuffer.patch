+#ifndef A6PLTE_KMEM_RNG_H
+#define A6PLTE_KMEM_RNG_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* Private per-CPU kmem state. The caller serializes access, as required by
+ * crypto_random_kmem_init's lock-free generation contract. */
+struct a6_kmem_rng {
+    uint32_t state[16];
+    uint8_t block[64];
+    unsigned used;
+};
+void a6_kmem_rng_init(struct a6_kmem_rng *, const uint8_t seed[44]);
+void a6_kmem_rng_generate(struct a6_kmem_rng *, void *, size_t);
+int a6_kmem_rng_uniform(struct a6_kmem_rng *, uint64_t bound, uint64_t *);
