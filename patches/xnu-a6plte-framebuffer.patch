diff --git c/bsd/dev/a6plte/compat.c w/bsd/dev/a6plte/compat.c
new file mode 100644
index 0000000..f4913d5
--- /dev/null
+++ w/bsd/dev/a6plte/compat.c
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Board-only bring-up policies and diagnostics, adapted for native XNU 8796. */
+#if A6PLTE
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <sys/priv.h>
+#include <sys/signal.h>
+#include <sys/kernel.h>
+#include <security/mac_policy.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_map.h>
+#include <mach/vm_region.h>
+
+static uint64_t sandbox_seen;
+static mac_policy_handle_t sandbox_handle;
+static char sample_names[128], scan_names[128];
+static LCK_GRP_DECLARE(compat_group,"a6plte compat");
+static LCK_MTX_DECLARE(compat_lock,&compat_group);
+static struct { int priv; char name[32]; } denied[64];
+static unsigned denied_count;
+extern void a6_sample_task(const char *, int, task_t);
+extern void thread_terminate_self(void);
+extern kern_return_t vm_map_region_recurse_64(vm_map_t,vm_map_offset_t *,vm_map_size_t *,
+    natural_t *,vm_region_submap_info_64_t,mach_msg_type_number_t *);
+
+static bool wanted(const char *list,const char *name) {
+    size_t length=strlen(name);
+    for (const char *p=list;*p;) {
+        const char *end=strchr(p,',');size_t n=end?(size_t)(end-p):strlen(p);
+        if (length && n==length && !strncmp(p,name,n)) return true;
+        if (!end) break;p=end+1;
+    }
+    return false;
+}
+static int sandbox_syscall(struct proc *p,int call,__unused user_addr_t arg) {
+    if (call>=0 && call<64 && !(__atomic_fetch_or(&sandbox_seen,1ULL<<call,__ATOMIC_RELAXED)&(1ULL<<call)))
+        printf("A6PLTE Sandbox: %s[%d] op %d (permissive)\n",p->p_comm,proc_pid(p),call);
+    switch (call) {
+    case 4: case 5: case 6: case 0x43: return ENOENT; /* no path/token to return */
+    default: return 0;
+    }
+}
+static int sandbox_priv_grant(__unused kauth_cred_t cred,int priv) {
+    if (priv==PRIV_WORK_INTERVAL) return 0;
+    char name[32]={0};bool log=true;proc_selfname(name,sizeof(name));
+    lck_mtx_lock(&compat_lock);
+    for (unsigned i=0;i<denied_count;++i)
+        if (denied[i].priv==priv && !strcmp(denied[i].name,name)) { log=false;break; }
+    if (log && denied_count<64) {
+        denied[denied_count].priv=priv;strlcpy(denied[denied_count++].name,name,sizeof(name));
+    } else log=false;
+    lck_mtx_unlock(&compat_lock);
+    if (log) printf("A6PLTE Sandbox: %s privilege %d not granted\n",name,priv);
+    return EPERM;
+}
+static const struct mac_policy_ops sandbox_ops={
+    .mpo_policy_syscall=sandbox_syscall,.mpo_priv_grant=sandbox_priv_grant,
+};
+static struct mac_policy_conf sandbox_conf={
+    .mpc_name="Sandbox",.mpc_fullname="A6PLTE permissive bring-up Sandbox",.mpc_ops=&sandbox_ops,
+};
+
+void a6_crash_process(proc_t p,int signal) {
+    if (p!=current_proc() || (signal!=SIGABRT && signal!=SIGTRAP)) return;
+    printf("A6PLTE CRASH: %s[%d] signal %d\n",p->p_comm,proc_pid(p),signal);
+    a6_sample_task(p->p_comm,proc_pid(p),proc_task(p));
+    if (!wanted(scan_names,p->p_comm)) return;
+    const size_t chunk=65536;char *buffer=kalloc_data(chunk,Z_WAITOK);
+    if (!buffer) return;
+    vm_map_t map=current_map();vm_map_offset_t address=0;uint64_t attempted=0;
+    unsigned lines=0,regions=0;char previous[160]={0};
+    printf("A6PLTE STR: heap scan of %s\n",p->p_comm);
+    while (lines<700 && attempted<(96ULL<<20) && ++regions<=4096) {
+        vm_map_size_t size=0;natural_t depth=0;vm_region_submap_info_data_64_t info;
+        mach_msg_type_number_t count=VM_REGION_SUBMAP_INFO_V2_COUNT_64;
+        if (vm_map_region_recurse_64(map,&address,&size,&depth,(vm_region_submap_info_64_t)&info,&count)!=KERN_SUCCESS ||
+            !size || address+size<address) break;
+        vm_map_offset_t base=address;address+=size;
+        if (info.is_submap || (info.protection&(VM_PROT_READ|VM_PROT_WRITE))!=(VM_PROT_READ|VM_PROT_WRITE) ||
+            info.user_tag<1 || info.user_tag>11) continue;
+        for (vm_map_size_t off=0;off<size && lines<700 && attempted<(96ULL<<20);off+=chunk) {
+            size_t length=MIN((vm_map_size_t)chunk,size-off);attempted+=length;
+            if (copyin((user_addr_t)(base+off),buffer,length)!=0) continue;
+            size_t start=0,spaces=0;
+            for (size_t i=0;i<=length && lines<700;++i) {
+                if (i<length && (unsigned char)buffer[i]>=32 && (unsigned char)buffer[i]<127) {
+                    spaces+=buffer[i]==' ';continue;
+                }
+                if (i-start>=24 && spaces>=2) {
+                    char line[160];size_t n=MIN(i-start,sizeof(line)-1);
+                    memcpy(line,buffer+start,n);line[n]=0;
+                    if (strcmp(line,previous)) {
+                        printf("STR %s\n",line);strlcpy(previous,line,sizeof(previous));++lines;
+                    }
+                }
+                start=i+1;spaces=0;
+            }
+        }
+    }
+    printf("A6PLTE STR: %llu KiB attempted, %u strings\n",attempted>>10,lines);
+    kfree_data(buffer,chunk);
+}
+static int sample_process(proc_t p,__unused void *arg) {
+    char name[32]={0};proc_name(proc_pid(p),name,sizeof(name));
+    if (wanted(sample_names,name)) {
+        task_t task=proc_task(p);
+        if (task!=TASK_NULL) a6_sample_task(name,proc_pid(p),task);
+    }
+    return PROC_RETURNED;
+}
+static void sample_thread(__unused void *arg,__unused wait_result_t wr) {
+    static int channel;
+    if (sample_names[0]!='-') {
+        (void)tsleep(&channel,PZERO,"a6sample",90*hz);
+        for (unsigned n=0;n<40;++n) {
+            printf("A6PLTE SMP: process sample %u/40\n",n+1);
+            proc_iterate(PROC_ALLPROCLIST,sample_process,NULL,NULL,NULL);
+            if (n+1<40) (void)tsleep(&channel,PZERO,"a6sample",120*hz);
+        }
+    }
+    thread_terminate_self();
+}
+void a6_compat_init(void) {
+    strlcpy(scan_names,"backboardd,SpringBoard",sizeof(scan_names));
+    strlcpy(sample_names,"SpringBoard,backboardd",sizeof(sample_names));
+    if (!PE_parse_boot_argn("a6_scan",scan_names,sizeof(scan_names)))
+        PE_parse_boot_argn("sweetscan",scan_names,sizeof(scan_names));
+    if (!PE_parse_boot_argn("a6_sample",sample_names,sizeof(sample_names)))
+        PE_parse_boot_argn("sweetsample",sample_names,sizeof(sample_names));
+    scan_names[sizeof(scan_names)-1]=0;sample_names[sizeof(sample_names)-1]=0;
+    int error=mac_policy_register(&sandbox_conf,&sandbox_handle,NULL);
+    printf("A6PLTE Sandbox: permissive policy %s (%d); CoreAnimation work intervals allowed\n",
+        error?"unavailable":"registered",error);
+    thread_t thread;
+    if (kernel_thread_start(sample_thread,NULL,&thread)==KERN_SUCCESS) thread_deallocate(thread);
+}
+#endif
diff --git c/bsd/dev/a6plte/cs_cache.c w/bsd/dev/a6plte/cs_cache.c
new file mode 100644
index 0000000..6b144e1
--- /dev/null
+++ w/bsd/dev/a6plte/cs_cache.c
@@ -0,0 +1,118 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Portable journal protocol. The VFS adapter owns permission/identity checks.
+ * Checksums detect corruption and interrupted writes; they are not signatures.
+ * The cache is trusted root-owned metadata, never an alternative CodeDirectory.
+ */
+#include "cs_cache.h"
+#ifdef KERNEL
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <libkern/crypto/sha2.h>
+#else
+#include <string.h>
+#include <errno.h>
+#include <openssl/sha.h>
+#endif
+
+static void put32(unsigned char *p, uint32_t x) {
+    for (unsigned i=0;i<4;++i) p[i]=(unsigned char)(x>>(i*8));
+}
+static void put64(unsigned char *p, uint64_t x) {
+    for (unsigned i=0;i<8;++i) p[i]=(unsigned char)(x>>(i*8));
+}
+static void digest(unsigned char *out, const unsigned char *header,
+    const unsigned char *data, size_t size) {
+    SHA256_CTX hash;
+    SHA256_Init(&hash); SHA256_Update(&hash,header,A6_CSC_HEADER_SIZE);
+    if (size) SHA256_Update(&hash,data,size);
+    SHA256_Final(out,&hash);
+}
+static int valid(const struct a6_csc *c) {
+    return c && c->limit && c->limit<=UINT32_MAX &&
+        c->hash_size && c->hash_size<=48 && c->io.read &&
+        (!c->writable || (c->io.write && c->io.resize && c->io.sync));
+}
+static uint64_t pages(uint64_t bytes) { return (bytes+4095)/4096; }
+static void header(const struct a6_csc *c, unsigned char *h) {
+    memset(h,0,A6_CSC_HEADER_SIZE); memcpy(h,"A6CS4K02",8);
+    put32(h+8,2); put32(h+12,22); put64(h+16,c->limit);
+    put32(h+24,c->hash_size); put64(h+32,pages(c->limit)*c->hash_size);
+    memcpy(h+40,c->key,32); digest(h+96,h,NULL,0);
+}
+static uint64_t record_offset(const struct a6_csc *c, uint64_t position) {
+    return A6_CSC_HEADER_SIZE + (position/A6_CSC_SOURCE_CHUNK)*
+        (A6_CSC_HEADER_SIZE + pages(A6_CSC_SOURCE_CHUNK)*c->hash_size);
+}
+static size_t record_size(const struct a6_csc *c, uint64_t position) {
+    uint64_t length=c->limit-position;
+    if (length>A6_CSC_SOURCE_CHUNK) length=A6_CSC_SOURCE_CHUNK;
+    return (size_t)(pages(length)*c->hash_size);
+}
+static void record_header(const struct a6_csc *c, unsigned char *h,
+    uint64_t position, size_t bytes) {
+    memset(h,0,A6_CSC_HEADER_SIZE); memcpy(h,"A6CSREC2",8);
+    put32(h+8,(uint32_t)(position/A6_CSC_SOURCE_CHUNK));
+    put32(h+12,(uint32_t)bytes);
+    uint64_t end=position+A6_CSC_SOURCE_CHUNK;
+    put64(h+16,end<c->limit?end:c->limit); memcpy(h+32,c->key,32);
+}
+int a6_csc_load(struct a6_csc *c, unsigned char *hashes) {
+    unsigned char h[A6_CSC_HEADER_SIZE], expected[A6_CSC_HEADER_SIZE], sum[32];
+    if (!valid(c) || !hashes) return EINVAL;
+    c->position=0; header(c,expected);
+    int error=0;
+    if (c->io.size>=A6_CSC_HEADER_SIZE) {
+        error=c->io.read(c->io.cookie,0,h,sizeof(h));
+        if (error) return error; /* Never destroy a journal after a read error. */
+    }
+    if (c->io.size<A6_CSC_HEADER_SIZE || memcmp(h,expected,sizeof(h))) {
+        /* A changed CodeDirectory/file identity never reuses an old record. */
+        if (!c->writable) return 0;
+        error=c->io.resize(c->io.cookie,0);
+        if (!error) error=c->io.write(c->io.cookie,0,expected,sizeof(expected));
+        if (!error) error=c->io.sync(c->io.cookie);
+        if (!error) c->io.size=sizeof(expected);
+        return error;
+    }
+    while (c->position<c->limit) {
+        uint64_t off=record_offset(c,c->position);
+        size_t bytes=record_size(c,c->position);
+        unsigned char *target=hashes+pages(c->position)*c->hash_size;
+        if (off>c->io.size || sizeof(h)+bytes>c->io.size-off) break;
+        error=c->io.read(c->io.cookie,off,h,sizeof(h));
+        if (error) break;
+        memcpy(sum,h+96,32); memset(h+96,0,32);
+        record_header(c,expected,c->position,bytes);
+        if (memcmp(h,expected,sizeof(h))) break;
+        error=c->io.read(c->io.cookie,off+sizeof(h),target,bytes);
+        if (!error) {
+            digest(expected,h,target,bytes);
+            if (memcmp(sum,expected,32)) error=EIO;
+        }
+        if (error) { memset(target,0,bytes); break; }
+        uint64_t next=c->position+A6_CSC_SOURCE_CHUNK;
+        c->position=next<c->limit?next:c->limit;
+    }
+    /* Only complete, independently checked records are visible to the caller.
+     * A missing/torn tail is normal after a reset; overwrite it on next save. */
+    return 0;
+}
+int a6_csc_save(struct a6_csc *c, const unsigned char *hashes, uint64_t position) {
+    unsigned char h[A6_CSC_HEADER_SIZE];
+    if (!valid(c) || !hashes || !c->writable || c->position>=c->limit ||
+        position<=c->position || position>c->limit ||
+        (position!=c->limit && position%A6_CSC_SOURCE_CHUNK) ||
+        position-c->position>A6_CSC_SOURCE_CHUNK) return EINVAL;
+    uint64_t end=c->position+A6_CSC_SOURCE_CHUNK;
+    if (position!=(end<c->limit?end:c->limit)) return EINVAL;
+    uint64_t off=record_offset(c,c->position);
+    size_t bytes=record_size(c,c->position);
+    const unsigned char *data=hashes+pages(c->position)*c->hash_size;
+    record_header(c,h,c->position,bytes); digest(h+96,h,data,bytes);
+    int error=c->io.write(c->io.cookie,off+sizeof(h),data,bytes);
+    if (!error) error=c->io.write(c->io.cookie,off,h,sizeof(h));
+    if (!error) error=c->io.resize(c->io.cookie,off+sizeof(h)+bytes);
+    if (!error) error=c->io.sync(c->io.cookie);
+    if (!error) { c->position=position; c->io.size=off+sizeof(h)+bytes; }
+    return error;
+}
diff --git c/bsd/dev/a6plte/cs_cache.h w/bsd/dev/a6plte/cs_cache.h
new file mode 100644
index 0000000..8d3d1f3
--- /dev/null
+++ w/bsd/dev/a6plte/cs_cache.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef A6PLTE_CS_CACHE_H
+#define A6PLTE_CS_CACHE_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* One append-only, checksummed record per 4 MiB of authenticated source.
+ * A reset can lose the last record, but cannot commit its unchecked tail. */
+#define A6_CSC_SOURCE_CHUNK (UINT64_C(4) * 1024 * 1024)
+#define A6_CSC_HEADER_SIZE 512u
+struct a6_csc_io {
+    void *cookie;
+    int (*read)(void *, uint64_t, void *, size_t);
+    int (*write)(void *, uint64_t, const void *, size_t);
+    int (*resize)(void *, uint64_t);
+    int (*sync)(void *);
+    uint64_t size;
+};
+struct a6_csc {
+    struct a6_csc_io io;
+    unsigned char key[32];
+    uint64_t limit, position;
+    unsigned hash_size;
+    int writable;
+};
+int a6_csc_load(struct a6_csc *, unsigned char *);
+int a6_csc_save(struct a6_csc *, const unsigned char *, uint64_t);
+
+#ifdef KERNEL
+#include <sys/vnode.h>
+struct a6_cs_cache;
+struct a6_cs_cache *a6_cs_cache_open(vnode_t, const void *, size_t,
+    int64_t, uint64_t, unsigned, unsigned char *, uint64_t *);
+int a6_cs_cache_save(struct a6_cs_cache *, const unsigned char *, uint64_t);
+int a6_cs_cache_close(struct a6_cs_cache *);
+#endif
+#endif
diff --git c/bsd/dev/a6plte/cs_cache_vfs.c w/bsd/dev/a6plte/cs_cache_vfs.c
new file mode 100644
index 0000000..1722103
--- /dev/null
+++ w/bsd/dev/a6plte/cs_cache_vfs.c
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Persistent 4K hash checkpoints, confined to the userdata root filesystem.
+ * This experimental port trusts root-owned cache metadata (as it trusts the
+ * supplied root filesystem). Checksums are not authentication against root.
+ * A read-only disk, unsafe file, or cache I/O error falls back to full native
+ * CodeDirectory verification. Source changes invalidate the entire checkpoint.
+ */
+#if A6PLTE
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/fcntl.h>
+#include <sys/stat.h>
+#include <sys/mount.h>
+#include <sys/uio.h>
+#include <sys/proc.h>
+#include <sys/kauth.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/crypto/sha2.h>
+#include "cs_cache.h"
+
+struct a6_cs_cache {
+    struct a6_csc journal;
+    vnode_t source, file;
+    int mode;
+    uint64_t identity[8];
+};
+static LCK_GRP_DECLARE(cache_group,"a6plte codesign cache");
+static LCK_MTX_DECLARE(cache_lock,&cache_group);
+
+static int source_identity(vnode_t vp, uint64_t *id) {
+    struct vnode_attr a; VATTR_INIT(&a);
+    VATTR_WANTED(&a,va_fileid); VATTR_WANTED(&a,va_data_size);
+    VATTR_WANTED(&a,va_modify_time); VATTR_WANTED(&a,va_change_time);
+    int error=vnode_getattr(vp,&a,vfs_context_kernel());
+    if (error) return error;
+    if (!VATTR_IS_SUPPORTED(&a,va_fileid) || !VATTR_IS_SUPPORTED(&a,va_data_size) ||
+        !VATTR_IS_SUPPORTED(&a,va_modify_time) || !VATTR_IS_SUPPORTED(&a,va_change_time)) return ENOTSUP;
+    id[0]=a.va_fileid; id[1]=a.va_data_size;
+    id[2]=(uint64_t)a.va_modify_time.tv_sec; id[3]=(uint64_t)a.va_modify_time.tv_nsec;
+    id[4]=(uint64_t)a.va_change_time.tv_sec; id[5]=(uint64_t)a.va_change_time.tv_nsec;
+    id[6]=id[7]=0; return 0;
+}
+static int cache_read(void *cookie, uint64_t off, void *data, size_t size) {
+    struct a6_cs_cache *c=cookie; int resid=0;
+    if (off>INT64_MAX || size>INT_MAX || size>INT64_MAX-off) return EINVAL;
+    int error=vn_rdwr(UIO_READ,c->file,data,(int)size,(off_t)off,UIO_SYSSPACE,0,
+        vfs_context_ucred(vfs_context_kernel()),&resid,vfs_context_proc(vfs_context_kernel()));
+    return error?error:resid?EIO:0;
+}
+static int cache_write(void *cookie, uint64_t off, const void *data, size_t size) {
+    struct a6_cs_cache *c=cookie; int resid=0;
+    if (off>INT64_MAX || size>INT_MAX || size>INT64_MAX-off) return EINVAL;
+    int error=vn_rdwr(UIO_WRITE,c->file,(caddr_t)data,(int)size,(off_t)off,UIO_SYSSPACE,IO_UNIT,
+        vfs_context_ucred(vfs_context_kernel()),&resid,vfs_context_proc(vfs_context_kernel()));
+    return error?error:resid?EIO:0;
+}
+static int cache_resize(void *cookie, uint64_t size) {
+    struct a6_cs_cache *c=cookie; struct vnode_attr a;
+    if (size>64*1024*1024) return EINVAL;
+    VATTR_INIT(&a); VATTR_SET(&a,va_data_size,size);
+    return vnode_setattr(c->file,&a,vfs_context_kernel());
+}
+static int cache_sync(void *cookie) {
+    struct a6_cs_cache *c=cookie;
+    /* HFS F_FULLFSYNC commits file/catalog data and reaches the eMMC flush. */
+    return VNOP_IOCTL(c->file,F_FULLFSYNC,NULL,0,vfs_context_kernel());
+}
+static int safe_file(struct a6_cs_cache *c) {
+    struct vnode_attr a; VATTR_INIT(&a);
+    VATTR_WANTED(&a,va_uid); VATTR_WANTED(&a,va_mode);
+    VATTR_WANTED(&a,va_nlink); VATTR_WANTED(&a,va_data_size);
+    if (!vnode_isreg(c->file) || c->file==c->source ||
+        vnode_mount(c->file)!=vnode_mount(rootvnode) ||
+        vnode_parent(c->file)!=rootvnode) return EPERM;
+    int error=vnode_getattr(c->file,&a,vfs_context_kernel());
+    if (error) return error;
+    if (!VATTR_IS_SUPPORTED(&a,va_uid) || !VATTR_IS_SUPPORTED(&a,va_mode) ||
+        !VATTR_IS_SUPPORTED(&a,va_nlink) || !VATTR_IS_SUPPORTED(&a,va_data_size) ||
+        a.va_uid!=0 || (a.va_mode&0777)!=0600 || a.va_nlink!=1 ||
+        a.va_data_size>64*1024*1024) return EPERM;
+    c->journal.io.size=a.va_data_size; return 0;
+}
+struct a6_cs_cache *a6_cs_cache_open(vnode_t source, const void *cd, size_t cd_size,
+    int64_t base, uint64_t limit, unsigned hash_size, unsigned char *hashes, uint64_t *position) {
+    extern int a6_userdata_root_selected(void);
+    *position=0;
+    if (!rootvnode || !a6_userdata_root_selected() || !source->v_name ||
+        strncmp(source->v_name,"dyld_shared_cache_arm64",23) ||
+        !vnode_isreg(source) || vnode_mount(source)!=vnode_mount(rootvnode)) return NULL;
+    struct a6_cs_cache *c=kalloc_type(struct a6_cs_cache,Z_WAITOK|Z_ZERO);
+    if (!c) return NULL;
+    c->source=source;
+    int error=source_identity(source,c->identity);
+    if (error) { kfree_type(struct a6_cs_cache,c); return NULL; }
+    SHA256_CTX h; SHA256_Init(&h);
+    SHA256_Update(&h,"A6CS4K02",8); SHA256_Update(&h,cd,cd_size);
+    SHA256_Update(&h,c->identity,sizeof(c->identity));
+    SHA256_Update(&h,&base,sizeof(base)); SHA256_Update(&h,&limit,sizeof(limit));
+    SHA256_Update(&h,&hash_size,sizeof(hash_size)); SHA256_Final(c->journal.key,&h);
+    char path[96]; const char hex[]="0123456789abcdef";
+    memcpy(path,"/.a6cs4k-v2-",12);
+    for (unsigned i=0;i<32;++i) { path[12+i*2]=hex[c->journal.key[i]>>4]; path[13+i*2]=hex[c->journal.key[i]&15]; }
+    path[76]=0;
+    c->mode=FREAD|FWRITE;
+    lck_mtx_lock(&cache_lock);
+    error=vnode_open(path,c->mode|O_CREAT|O_NOFOLLOW,0600,
+        VNODE_LOOKUP_NOFOLLOW|VNODE_LOOKUP_NOCROSSMOUNT,&c->file,vfs_context_kernel());
+    if (error==EROFS) {
+        c->mode=FREAD;
+        error=vnode_open(path,FREAD|O_NOFOLLOW,0,
+            VNODE_LOOKUP_NOFOLLOW|VNODE_LOOKUP_NOCROSSMOUNT,&c->file,vfs_context_kernel());
+    }
+    if (!error) error=safe_file(c);
+    c->journal.limit=limit; c->journal.hash_size=hash_size;
+    c->journal.writable=(c->mode&FWRITE)!=0;
+    c->journal.io.cookie=c; c->journal.io.read=cache_read; c->journal.io.write=cache_write;
+    c->journal.io.resize=cache_resize; c->journal.io.sync=cache_sync;
+    if (!error) error=a6_csc_load(&c->journal,hashes);
+    if (error) {
+        printf("A6PLTE codesign cache: %s unavailable errno %d; verifying source\n",source->v_name,error);
+        if (c->file) vnode_close(c->file,c->mode,vfs_context_kernel());
+        lck_mtx_unlock(&cache_lock); kfree_type(struct a6_cs_cache,c); return NULL;
+    }
+    *position=c->journal.position;
+    if (*position) printf("A6PLTE codesign cache: %s reused %llu / %llu MiB%s\n",
+        source->v_name,*position>>20,limit>>20,*position==limit?" (complete)":"; resuming");
+    else if (c->journal.writable) printf("A6PLTE codesign cache: %s saving 4 MiB checkpoints on userdata\n",source->v_name);
+    return c;
+}
+int a6_cs_cache_save(struct a6_cs_cache *c, const unsigned char *hashes, uint64_t position) {
+    if (!c || !c->journal.writable || position==c->journal.position) return 0;
+    if (position!=c->journal.limit && position%A6_CSC_SOURCE_CHUNK) return 0;
+    int error=a6_csc_save(&c->journal,hashes,position);
+    if (error) {
+        c->journal.writable=0;
+        printf("A6PLTE codesign cache: %s checkpoint errno %d; verification continues\n",c->source->v_name,error);
+    }
+    return error;
+}
+int a6_cs_cache_close(struct a6_cs_cache *c) {
+    if (!c) return 0;
+    uint64_t identity[8]; int error=source_identity(c->source,identity);
+    if (!error && memcmp(identity,c->identity,sizeof(identity))) error=ESTALE;
+    if (error && (c->mode&FWRITE)) { cache_resize(c,0); cache_sync(c); }
+    vnode_close(c->file,c->mode,vfs_context_kernel());
+    lck_mtx_unlock(&cache_lock); kfree_type(struct a6_cs_cache,c);
+    return error;
+}
+#endif
diff --git c/bsd/dev/a6plte/dyld_diag.c w/bsd/dev/a6plte/dyld_diag.c
new file mode 100644
index 0000000..3853d9d
--- /dev/null
+++ w/bsd/dev/a6plte/dyld_diag.c
@@ -0,0 +1,173 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Read-only diagnostics for user-provided split dyld caches. No file changes. */
+#if A6PLTE
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/mount.h>
+#include <sys/uio.h>
+#include <sys/kauth.h>
+#include <sys/proc.h>
+#include <kern/kalloc.h>
+#include "dyld_diag.h"
+static unsigned present,missing_files,bad_files,signatures;
+static char first_issue[384],last_signature[192],last_mmap[192],last_map[128],blob_failure[192];
+static unsigned region_checks;
+static int region_check_result;
+static uint64_t region_address;
+void a6_dyld_note_check(int result,uint64_t address) {
+    ++region_checks;region_check_result=result;region_address=address;
+    /* KERN_INVALID_ADDRESS is the normal pre-map empty-region probe. Do not
+     * invent a mapping or return success: dyld must perform the real map2. */
+    if (result==0) printf("A6PLTE dyld: shared cache mapped at 0x%llx\n",(unsigned long long)address);
+}
+void a6_dyld_note_signature(const char *name,int error,int64_t coverage,uint64_t offset,const char *stage) {
+    snprintf(last_signature,sizeof(last_signature),"%s errno %d coverage %lld / %llu (%s)",
+        name,error,(long long)coverage,(unsigned long long)offset,stage);
+    if (!error) ++signatures;
+    if (!first_issue[0] && (error || coverage<0 || (uint64_t)coverage<offset))
+        snprintf(first_issue,sizeof(first_issue),"signature: %s",last_signature);
+    printf("A6PLTE dyld: signature %s\n",last_signature);
+}
+void a6_dyld_note_blob(const char *stage,int error,int pageshift,unsigned limit,int64_t start,int64_t end) {
+    snprintf(blob_failure,sizeof(blob_failure),"%s errno %d shift %d limit %u range %lld..%lld",
+        stage,error,pageshift,limit,(long long)start,(long long)end);
+    printf("A6PLTE dyld: blob rejected: %s\n",blob_failure);
+}
+void a6_dyld_note_mmap(const char *name,int error,uint64_t offset,uint64_t length) {
+    snprintf(last_mmap,sizeof(last_mmap),"%s errno %d offset %llu bytes %llu",name,error,
+        (unsigned long long)offset,(unsigned long long)length);
+    if (error && !first_issue[0]) snprintf(first_issue,sizeof(first_issue),"mmap: %s",last_mmap);
+    printf("A6PLTE dyld: mmap %s\n",last_mmap);
+}
+void a6_dyld_note_map(unsigned files,unsigned mappings,int error) {
+    snprintf(last_map,sizeof(last_map),"%u files, %u mappings, errno %d",files,mappings,error);
+    if (error && !first_issue[0]) snprintf(first_issue,sizeof(first_issue),"map2: %s",last_map);
+    printf("A6PLTE dyld: shared region %s\n",last_map);
+}
+int a6_dyld_root_cache(struct vnode *vp,struct vnode *rdir) {
+    extern int a6_userdata_root_selected(void);
+    if (!vp || !rootvnode || rdir!=rootvnode || !a6_userdata_root_selected() ||
+        !vnode_isreg(vp) || vnode_mount(vp)!=vnode_mount(rootvnode) || !vp->v_name)
+        return 0;
+    const char *name=vp->v_name;
+    const size_t prefix=sizeof("dyld_shared_cache_arm64")-1;
+    if (strncmp(name,"dyld_shared_cache_arm64",prefix) ||
+        (name[prefix] && name[prefix]!='.')) return 0;
+    struct vnode_attr a; VATTR_INIT(&a); VATTR_WANTED(&a,va_uid);
+    if (vnode_getattr(vp,&a,vfs_context_current()) ||
+        !VATTR_IS_SUPPORTED(&a,va_uid) || a.va_uid!=0) return 0;
+    static const char *directories[]={
+        "/System/Library/Caches/com.apple.dyld",
+        "/System/Library/dyld",
+        "/System/Cryptexes/OS/System/Library/Caches/com.apple.dyld",
+        "/System/Cryptexes/OS/System/Library/dyld"
+    };
+    for (unsigned i=0;i<sizeof(directories)/sizeof(directories[0]);++i) {
+        vnode_t parent=NULL;
+        int error=vnode_lookup(directories[i],VNODE_LOOKUP_NOCROSSMOUNT,
+            &parent,vfs_context_current());
+        if (error) continue;
+        int match=parent==vnode_parent(vp) &&
+            vnode_mount(parent)==vnode_mount(rootvnode);
+        vnode_put(parent);
+        if (match) return 1;
+    }
+    return 0;
+}
+void a6_dyld_report(void) {
+    extern void a6_input_probe_status(uint32_t *,uint32_t *,uint32_t *);
+    uint32_t reg,value,command;a6_input_probe_status(&reg,&value,&command);
+    printf("\nA6PLTE BOOT DIAGNOSTICS (CPU0)\n");
+    if (reg) printf("S6SY761: command %x reg %08x value %08x\n",command,reg,value);
+    printf("dyld: %u caches, %u missing parts, %u invalid, %u signed\n",
+        present,missing_files,bad_files,signatures);
+    if (!present) printf("dyld: none of the known arm64 cache paths opened\n");
+    if (first_issue[0]) printf("dyld first failure: %s\n",first_issue);
+    if (last_signature[0]) printf("dyld last signature: %s\n",last_signature);
+    if (blob_failure[0]) printf("dyld blob failure: %s\n",blob_failure);
+    if (last_mmap[0]) printf("dyld last mmap: %s\n",last_mmap);
+    if (last_map[0]) printf("dyld last map2: %s\n",last_map);
+    else printf("dyld: map2 syscall not reached\n");
+    if (region_checks) printf("dyld region check: kr %d address 0x%llx (%u checks)\n",
+        region_check_result,(unsigned long long)region_address,region_checks);
+}
+static uint32_t le32(const unsigned char *p) {
+    return p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;
+}
+static uint64_t le64(const unsigned char *p) { return le32(p)|(uint64_t)le32(p+4)<<32; }
+static int read_exact(vnode_t vp,uint64_t offset,void *data,unsigned size,uint64_t length) {
+    if (offset>length || size>length-offset || offset>INT64_MAX) return EINVAL;
+    int resid=0,error=vn_rdwr(UIO_READ,vp,data,(int)size,(off_t)offset,UIO_SYSSPACE,0,
+        kauth_cred_get(),&resid,current_proc());
+    return error?error:resid?EIO:0;
+}
+static void cache_check(const char *path,unsigned char *header) {
+    vnode_t vp=NULL;int error=vnode_lookup(path,0,&vp,vfs_context_current());
+    if (error) return;
+    ++present;
+    off_t size=0;error=vnode_size(vp,&size,vfs_context_current());
+    if (!error && size>=0) error=read_exact(vp,0,header,512,(uint64_t)size);
+    else if (!error) error=EINVAL;
+    if (error || memcmp(header,"dyld_",5)) {
+        ++bad_files;if (!first_issue[0]) snprintf(first_issue,sizeof(first_issue),"cache header %s errno %d",path,error);
+        printf("A6PLTE dyld: %s invalid header/read error %d\n",path,error);vnode_put(vp);return;
+    }
+    uint32_t mapping=le32(header+16),count=0,array=0;
+    /* Public dyld cache format: subCacheArrayOffset/Count at 0x188/0x18c,
+     * cacheSubType at 0x1c8. Older headers do not contain these fields. */
+    if (mapping>=0x190) { array=le32(header+0x188);count=le32(header+0x18c); }
+    printf("A6PLTE dyld: %s size %llu, platform %u, %u subcaches\n",path,
+        (unsigned long long)size,le32(header+0xd8),count);
+    uint64_t signature=le64(header+40),signature_size=le64(header+48);
+    if (signature>(uint64_t)size || signature_size>(uint64_t)size-signature) {
+        ++bad_files;if (!first_issue[0]) snprintf(first_issue,sizeof(first_issue),"signature outside %s",path);
+        printf("A6PLTE dyld: cache signature outside file\n");
+    }
+    if (count>64) { ++bad_files;printf("A6PLTE dyld: excessive subcache count\n");vnode_put(vp);return; }
+    bool suffixes=mapping>0x1c8;unsigned stride=suffixes?56:24,missing=0,invalid=0;
+    for (unsigned i=0;i<count;++i) {
+        unsigned char entry[56],child_header[104];char suffix[33],child_path[384];
+        error=read_exact(vp,(uint64_t)array+(uint64_t)i*stride,entry,stride,(uint64_t)size);
+        if (error) { printf("A6PLTE dyld: subcache table read error %d\n",error);++invalid;break; }
+        if (suffixes) {
+            memcpy(suffix,entry+24,32);suffix[32]=0;
+            bool valid=suffix[0]=='.' && memchr(suffix,0,32)!=NULL;
+            for (unsigned j=1;suffix[j] && j<32;++j)
+                if (!((suffix[j]>='0' && suffix[j]<='9') || (suffix[j]>='a' && suffix[j]<='z') ||
+                    (suffix[j]>='A' && suffix[j]<='Z') || suffix[j]=='.' || suffix[j]=='_')) valid=false;
+            if (!valid) { printf("A6PLTE dyld: invalid subcache suffix %u\n",i);++invalid;continue; }
+        } else snprintf(suffix,sizeof(suffix),".%u",i+1);
+        if (snprintf(child_path,sizeof(child_path),"%s%s",path,suffix)>=(int)sizeof(child_path)) { ++invalid;continue; }
+        vnode_t child=NULL;error=vnode_lookup(child_path,0,&child,vfs_context_current());
+        if (error) {
+            if (!first_issue[0]) snprintf(first_issue,sizeof(first_issue),"open %s errno %d",child_path,error);
+            printf("A6PLTE dyld: MISSING %s errno %d\n",child_path,error);++missing;continue;
+        }
+        off_t child_size=0;error=vnode_size(child,&child_size,vfs_context_current());
+        if (!error && child_size>=0) error=read_exact(child,0,child_header,sizeof(child_header),(uint64_t)child_size);
+        else if (!error) error=EINVAL;
+        if (error || memcmp(child_header,"dyld_",5) || memcmp(child_header+88,entry,16)) {
+            if (!first_issue[0]) snprintf(first_issue,sizeof(first_issue),"subcache header/UUID %s errno %d",child_path,error);
+            printf("A6PLTE dyld: BAD HEADER/UUID %s errno %d\n",child_path,error);++invalid;
+        }
+        vnode_put(child);
+    }
+    printf("A6PLTE dyld: split files checked: %u missing, %u invalid\n",missing,invalid);
+    missing_files+=missing;bad_files+=invalid;
+    vnode_put(vp);
+}
+void a6_dyld_preflight(void) {
+    unsigned char *header=kalloc_data(512,Z_WAITOK);
+    if (!header) return;
+    static const char *paths[]={
+        "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+        "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.development",
+        "/System/Library/dyld/dyld_shared_cache_arm64",
+        "/System/Cryptexes/OS/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64",
+    };
+    for (unsigned i=0;i<sizeof(paths)/sizeof(paths[0]);++i) cache_check(paths[i],header);
+    kfree_data(header,512);
+}
+#endif
