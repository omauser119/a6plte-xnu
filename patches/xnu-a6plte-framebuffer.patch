+static IOReturn aksMethod(uint32_t selector,IOExternalMethodArguments *args) {
+    if (!args || args->asyncWakePort || args->asyncReferenceCount || args->structureInputDescriptor)
+        return kIOReturnBadArgument;
+    if (selector==17 || selector==35) {
+        uint8_t data[128];unsigned size=a6_aks_extended_state(data,sizeof(data));
+        args->scalarOutputCount=0;
+        if (args->structureOutputDescriptor) {
+            if (args->structureOutputDescriptor->getLength()<size) return kIOReturnNoSpace;
+            if (args->structureOutputDescriptor->writeBytes(0,data,size)!=size) return kIOReturnError;
+            args->structureOutputDescriptorSize=size;
+        } else {
+            if (!args->structureOutput || args->structureOutputSize<size) return kIOReturnNoSpace;
+            bcopy(data,args->structureOutput,size);args->structureOutputSize=size;
+        }
+        return kIOReturnSuccess;
+    }
+    if (selector==7 || selector==14) {
+        if (!args->scalarOutput || args->scalarOutputCount<1) return kIOReturnBadArgument;
+        args->scalarOutput[0]=(selector==7)?4:0;args->scalarOutputCount=1;
+        args->structureOutputSize=0;args->structureOutputDescriptorSize=0;return kIOReturnSuccess;
+    }
+    if (selector==0 || selector==101) {
+        args->scalarOutputCount=0;args->structureOutputSize=0;args->structureOutputDescriptorSize=0;
+        return kIOReturnSuccess;
+    }
+    return kIOReturnUnsupported;
+}
+static IOReturn openClient(IOService *service,task_t task,void *security,UInt32 type,
+    OSDictionary *properties,IOUserClient **handler,bool keyStore=false) {
+    if (!handler) return kIOReturnBadArgument;
+    *handler=nullptr;
+    if (type!=A6_SERVICE_CONNECT_TYPE && !(keyStore && type==0)) return kIOReturnUnsupported;
+    if (IOUserClient::clientHasPrivilege(task,kIOClientPrivilegeAdministrator)!=kIOReturnSuccess)
+        return kIOReturnNotPrivileged;
+    A6PlatformUserClient *client=new A6PlatformUserClient;
+    if (!client) return kIOReturnNoMemory;
+    if (!client->initWithTask(task,security,type,properties)) { client->release();return kIOReturnNoMemory; }
+    client->setProperty(kIOUserClientDefaultLockingKey,true);
+    if (!client->attach(service)) { client->release();return kIOReturnError; }
+    if (!client->start(service)) { client->detach(service);client->release();return kIOReturnError; }
+    *handler=client;return kIOReturnSuccess;
+}
+IOReturn IOSurfaceRoot::newUserClient(task_t t,void *s,UInt32 type,OSDictionary *p,IOUserClient **h) {
+    return openClient(this,t,s,type,p,h);
+}
+IOReturn IOMobileFramebuffer::newUserClient(task_t t,void *s,UInt32 type,OSDictionary *p,IOUserClient **h) {
+    return openClient(this,t,s,type,p,h);
+}
+IOReturn AppleKeyStore::newUserClient(task_t t,void *s,UInt32 type,OSDictionary *p,IOUserClient **h) {
+    return openClient(this,t,s,type,p,h,true);
+}
+bool A6PlatformUserClient::start(IOService *provider) {
+    if (!IOUserClient::start(provider) || !(clientLock=IOLockAlloc())) return false;
+    surfaceRoot=OSDynamicCast(IOSurfaceRoot,provider);
+    keyStore=OSDynamicCast(AppleKeyStore,provider)!=nullptr;
+    framebuffer=OSDynamicCast(IOMobileFramebuffer,provider);
+    if (surfaceRoot) surfaceRoot->retain();
+    if (framebuffer) {
+        framebuffer->retain();const struct a6_display *d=framebuffer->getDisplay();
+        aperture=IODeviceMemory::withRange(d->physical_address,d->info.size);
+        if (!aperture) return false;
+    }
+    return true;
+}
+void A6PlatformUserClient::free() {
+    if (surface) surface->release();if (aperture) aperture->release();
+    if (surfaceRoot) surfaceRoot->release();if (framebuffer) framebuffer->release();
+    if (clientLock) IOLockFree(clientLock);IOUserClient::free();
+}
+IOReturn A6PlatformUserClient::clientClose() { terminate();return kIOReturnSuccess; }
+IOReturn A6PlatformUserClient::externalMethod(uint32_t selector,IOExternalMethodArguments *a,
+    __unused IOExternalMethodDispatch *dispatch,__unused OSObject *target,__unused void *reference) {
+    if (isInactive()) return kIOReturnNotReady;
+    if (keyStore) return aksMethod(selector,a);
+    if (!a || a->asyncWakePort || a->asyncReferenceCount || a->structureInputDescriptor || a->structureOutputDescriptor)
+        return kIOReturnBadArgument;
+    if (isInactive()) return kIOReturnNotReady;
+    static const IOExternalMethodDispatch surfaceMethods[]={
+        {create,3,0,0,sizeof(struct a6_surface_info)},
+        {info,0,0,0,sizeof(struct a6_surface_info)}, {destroy,0,0,0,0}
+    };
+    static const IOExternalMethodDispatch displayMethods[]={
+        {displayInfo,0,0,0,sizeof(struct a6_display_info)},
+        {displayBlit,5,kIOUCVariableStructureSize,0,0}
+    };
+    const IOExternalMethodDispatch *entry=nullptr;
+    if (surfaceRoot && selector<sizeof(surfaceMethods)/sizeof(surfaceMethods[0])) entry=&surfaceMethods[selector];
+    else if (framebuffer && selector<sizeof(displayMethods)/sizeof(displayMethods[0])) entry=&displayMethods[selector];
+    if (!entry) return kIOReturnUnsupported;
+    return IOUserClient::externalMethod(selector,a,const_cast<IOExternalMethodDispatch *>(entry),this,nullptr);
+}
+IOReturn A6PlatformUserClient::create(OSObject *object,__unused void *reference,IOExternalMethodArguments *a) {
+    A6PlatformUserClient *self=OSDynamicCast(A6PlatformUserClient,object);
+    struct a6_surface_info layout;
+    if (!self || !a6_surface_layout(a->scalarInput[0],a->scalarInput[1],a->scalarInput[2],&layout)) return kIOReturnBadArgument;
+    IOLockLock(self->clientLock);
+    IOReturn result=kIOReturnBusy;
+    if (!self->surface) {
+        self->surface=A6SurfaceMemory::allocate(self->surfaceRoot,layout.size);
+        result=self->surface?kIOReturnSuccess:kIOReturnNoMemory;
+        if (self->surface) { self->surfaceInfo=layout;bcopy(&layout,a->structureOutput,sizeof(layout)); }
+    }
+    IOLockUnlock(self->clientLock);return result;
+}
+IOReturn A6PlatformUserClient::info(OSObject *object,__unused void *reference,IOExternalMethodArguments *a) {
+    A6PlatformUserClient *self=OSDynamicCast(A6PlatformUserClient,object);
+    if (!self) return kIOReturnBadArgument;
+    IOLockLock(self->clientLock);
+    IOReturn result=self->surface?kIOReturnSuccess:kIOReturnNotReady;
+    if (self->surface) bcopy(&self->surfaceInfo,a->structureOutput,sizeof(self->surfaceInfo));
+    IOLockUnlock(self->clientLock);return result;
+}
+IOReturn A6PlatformUserClient::destroy(OSObject *object,__unused void *reference,__unused IOExternalMethodArguments *a) {
+    A6PlatformUserClient *self=OSDynamicCast(A6PlatformUserClient,object);
+    if (!self) return kIOReturnBadArgument;
+    IOLockLock(self->clientLock);
+    A6SurfaceMemory *memory=self->surface;self->surface=nullptr;self->surfaceInfo={};
+    IOLockUnlock(self->clientLock);if (memory) memory->release();return kIOReturnSuccess;
+}
+IOReturn A6PlatformUserClient::displayInfo(OSObject *object,__unused void *reference,IOExternalMethodArguments *a) {
+    A6PlatformUserClient *self=OSDynamicCast(A6PlatformUserClient,object);
+    if (!self || !self->framebuffer) return kIOReturnNotReady;
+    bcopy(&self->framebuffer->getDisplay()->info,a->structureOutput,sizeof(struct a6_display_info));
+    return kIOReturnSuccess;
+}
+IOReturn A6PlatformUserClient::displayBlit(OSObject *object,__unused void *reference,IOExternalMethodArguments *a) {
+    A6PlatformUserClient *self=OSDynamicCast(A6PlatformUserClient,object);
+    if (!self || !self->framebuffer) return kIOReturnNotReady;
+    if (!a->structureInput || a->structureInputSize>65536) return kIOReturnBadArgument;
+    return self->framebuffer->blit(a->scalarInput,(const uint8_t *)a->structureInput,a->structureInputSize);
+}
+IOReturn A6PlatformUserClient::clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory) {
+    if (!options || !memory) return kIOReturnBadArgument;
+    *memory=nullptr;*options=0;
+    if (type!=A6_SERVICE_MEMORY || isInactive()) return kIOReturnUnsupported;
+    IOLockLock(clientLock);
+    IOMemoryDescriptor *descriptor=surface?static_cast<IOMemoryDescriptor *>(surface):aperture;
+    if (descriptor) {
+        descriptor->retain();*memory=descriptor;
+        if (aperture) *options=kIOMapReadOnly | kIOMapInhibitCache;
+    }
+    IOLockUnlock(clientLock);return descriptor?kIOReturnSuccess:kIOReturnNotReady;
+}
+
+template <typename Service> static void startBoardService(IOService *provider,const char *name) {
+    Service *service=new Service;
+    if (!service) { IOLog("A6PLTE: %s allocation failed\n",name);return; }
+    bool attached=false;
+    if (!service->init() || !(attached=service->attach(provider)) || !service->start(provider)) {
+        IOLog("A6PLTE: %s start failed\n",name);
+        if (attached) service->detach(provider);
+    }
+    service->release();
+}
+extern void a6_start_input(IOService *);
+void a6_start_platform_services(IOService *provider) {
+    startBoardService<A6PLTEWatchdog>(provider,"watchdog");
+    startBoardService<AppleKeyStore>(provider,"AppleKeyStore");
+    startBoardService<AppleSmartBattery>(provider,"battery");
+    startBoardService<IOSurfaceRoot>(provider,"IOSurfaceRoot");
+    startBoardService<IOMobileFramebuffer>(provider,"IOMobileFramebuffer");
+    a6_start_input(provider);
+}
+#endif
