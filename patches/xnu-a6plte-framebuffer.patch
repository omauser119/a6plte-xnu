+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef A6_GIC_H
+#define A6_GIC_H
+#include <stdint.h>
+#include <stddef.h>
+#define A6_GICD_PA 0x0b000000u
+#define A6_GICC_PA 0x0b002000u
+#define A6_VTIMER_IRQ 20u /* DT arm,armv8-timer: PPI 4 + 16, not generic IRQ 27. */
+#define A6_IPI_IRQ 1u
+struct a6_gic {
+    uintptr_t dist, cpu;
+    uint32_t (*read)(uintptr_t);
+    void (*write)(uintptr_t,uint32_t);
+    void (*barrier)(void);
+    unsigned lines;
+};
+int a6_gic_init(struct a6_gic *);
+int a6_gic_local_init(struct a6_gic *);
+void a6_gic_send_ipi(struct a6_gic *,unsigned);
+unsigned a6_gic_ack(struct a6_gic *,uint32_t *);
+void a6_gic_end(struct a6_gic *,uint32_t);
+void a6_gic_mask(struct a6_gic *,unsigned);
+#endif
