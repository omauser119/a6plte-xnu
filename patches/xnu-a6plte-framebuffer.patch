 /*
@@ -229,10 +245,14 @@ read_erandom(void * buf, size_t nbytes)
 	size_t n;
 	int rc;
 
-	// We defer to the kernel PRNG after it has been installed and
-	// initialized. This happens during corecrypto kext
-	// initialization.
+#if A6PLTE
+	bool locked = a6_boot_random_lock_ready;
+	if (locked) lck_spin_lock(&a6_boot_random_lock);
+#endif
