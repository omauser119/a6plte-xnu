diff --git c/bsd/dev/a6plte/gpt.c w/bsd/dev/a6plte/gpt.c
new file mode 100644
index 0000000..c8c1346
--- /dev/null
+++ w/bsd/dev/a6plte/gpt.c
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Bounded GPT verification and userdata-only block translation. */
+#include "storage.h"
+
+static uint32_t le32(const uint8_t *p) {
+    return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24;
+}
+static uint64_t le64(const uint8_t *p) { return le32(p) | (uint64_t)le32(p+4)<<32; }
+static int equal(const uint8_t *a, const uint8_t *b, unsigned n) {
+    while (n--) if (*a++ != *b++) return 0;
+    return 1;
+}
+static int nonzero(const uint8_t *p, unsigned n) {
+    unsigned v=0; while (n--) v |= *p++; return v != 0;
+}
+static uint32_t crc_byte(uint32_t crc, unsigned c) {
+    crc ^= c;
+    for (unsigned j=0;j<8;++j) crc=(crc>>1) ^ (0xedb88320u & (0u-(crc&1)));
+    return crc;
+}
+uint32_t a6_storage_crc32(const void *ptr, size_t n) {
+    const uint8_t *p=ptr; uint32_t c=~0u;
+    while (n--) c=crc_byte(c,*p++);
+    return ~c;
+}
+struct header { uint64_t first,last,table; uint32_t count,stride,crc; };
+static int header(const uint8_t *p, uint64_t here, uint64_t other, struct header *h) {
+    static const uint8_t magic[8]={'E','F','I',' ','P','A','R','T'};
+    unsigned bytes=le32(p+12);
+    if (!equal(p,magic,8) || le32(p+8)!=0x10000 || bytes<92 || bytes>512 ||
+        le32(p+20) || le64(p+24)!=here || le64(p+32)!=other || !nonzero(p+56,16)) return A6_IO_GPT;
+    uint32_t c=~0u;
+    for (unsigned i=0;i<bytes;++i) c=crc_byte(c,i>=16 && i<20 ? 0 : p[i]);
+    if (~c!=le32(p+16)) return A6_IO_GPT;
+    h->first=le64(p+40);h->last=le64(p+48);h->table=le64(p+72);
+    h->count=le32(p+80);h->stride=le32(p+84);h->crc=le32(p+88);
+    if (!h->count || h->count>128 || h->stride<128 || h->stride>512 ||
+        (h->stride & (h->stride-1)) || h->first>h->last) return A6_IO_GPT;
+    return 0;
+}
+int a6_gpt_userdata(struct a6_blockdev *disk, struct a6_slice *out) {
+    uint8_t p[512],b[512],pb[512],bb[512];
+    struct header ph,bh;
+    struct { uint64_t first,last; uint8_t guid[16]; } used[128];
+    unsigned nused=0,found=0;
+    struct a6_slice result={0};
+    if (!out) return A6_IO_INVALID;
+    *out=result;
+    if (!disk || !disk->read || disk->blocks<68 || disk->blocks>UINT64_MAX/512) return A6_IO_INVALID;
+    if (disk->read(disk->cookie,0,1,p)) return A6_IO_ERROR;
+    if (p[510]!=0x55 || p[511]!=0xaa) return A6_IO_GPT;
+    unsigned protective=0;
+    for (unsigned i=446;i<510;i+=16) {
+        if (p[i+4]==0xee && le32(p+i+8)==1) ++protective;
+        else if (p[i+4]) return A6_IO_GPT; /* No hybrid MBR interpretation. */
+    }
+    if (protective!=1) return A6_IO_GPT;
+    if (disk->read(disk->cookie,1,1,p) || disk->read(disk->cookie,disk->blocks-1,1,b)) return A6_IO_ERROR;
+    if (header(p,1,disk->blocks-1,&ph) || header(b,disk->blocks-1,1,&bh)) return A6_IO_GPT;
+    uint64_t bytes=(uint64_t)ph.count*ph.stride, sectors=(bytes+511)/512;
+    if (!equal(p+56,b+56,16) || ph.first!=bh.first || ph.last!=bh.last ||
+        ph.count!=bh.count || ph.stride!=bh.stride || ph.crc!=bh.crc ||
+        ph.table<2 || ph.table>=ph.first || sectors>ph.first-ph.table ||
+        bh.table<=ph.last || bh.table>=disk->blocks-1 || sectors>disk->blocks-1-bh.table ||
+        ph.first<2+sectors || ph.last>=disk->blocks-1-sectors) return A6_IO_GPT;
+    uint32_t crc=~0u;
+    for (uint64_t i=0;i<sectors;++i) {
+        if (disk->read(disk->cookie,ph.table+i,1,pb) || disk->read(disk->cookie,bh.table+i,1,bb)) return A6_IO_ERROR;
+        unsigned take=bytes-i*512<512 ? (unsigned)(bytes-i*512) : 512;
+        if (!equal(pb,bb,take)) return A6_IO_GPT;
+        for (unsigned j=0;j<take;++j) crc=crc_byte(crc,pb[j]);
+        for (unsigned j=0;j<take;j+=ph.stride) {
+            const uint8_t *e=pb+j;
+            if (!nonzero(e,16)) continue;
+            uint64_t first=le64(e+32),last=le64(e+40);
+            if (first<ph.first || last>ph.last || first>last || !nonzero(e+16,16)) return A6_IO_GPT;
+            for (unsigned k=0;k<nused;++k) {
+                if ((first<=used[k].last && used[k].first<=last) || equal(e+16,used[k].guid,16)) return A6_IO_GPT;
+            }
+            used[nused].first=first;used[nused].last=last;
+            for (unsigned k=0;k<16;++k) used[nused].guid[k]=e[16+k];
+            ++nused;
+            static const char name[]="userdata";
+            unsigned match=1;
+            for (unsigned k=0;k<sizeof(name);++k) if (e[56+k*2]!=(uint8_t)name[k] || e[57+k*2]) match=0;
+            if (match) {
+                if (found++) return A6_IO_GPT;
+                result.disk=disk;result.first=first;result.count=last-first+1;result.attributes=le64(e+48);
+            }
+        }
+    }
+    if (~crc!=ph.crc || found!=1) return A6_IO_GPT;
+    *out=result;
+    return 0;
+}
+int a6_slice_io(struct a6_slice *p, int write, uint64_t lba, uint32_t count, void *buf) {
+    if (!p || !p->disk || !p->count || p->first>=p->disk->blocks ||
+        p->count>p->disk->blocks-p->first || lba>p->count || count>p->count-lba ||
+        (count && !buf) || (uint64_t)count>SIZE_MAX/512) return A6_IO_INVALID;
+    if (!count) return 0;
+    if (write) {
+        if (!p->writable || (p->attributes & (UINT64_C(1)<<60))) return A6_IO_READONLY;
+        if (!p->disk->write || !p->disk->flush) return A6_IO_OFFLINE;
+        int err=p->disk->write(p->disk->cookie,p->first+lba,count,buf);
+        return err ? err : p->disk->flush(p->disk->cookie);
+    }
+    if (!p->disk->read) return A6_IO_OFFLINE;
+    return p->disk->read(p->disk->cookie,p->first+lba,count,buf);
+}
diff --git c/bsd/dev/a6plte/hfs_volume.c w/bsd/dev/a6plte/hfs_volume.c
new file mode 100644
index 0000000..b15d1b9
--- /dev/null
+++ w/bsd/dev/a6plte/hfs_volume.c
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Read-only validation of a bare HFS+/HFSX volume inside the userdata slice. */
+#include "storage.h"
+static uint16_t be16(const uint8_t *p) { return (uint16_t)((unsigned)p[0]<<8 | p[1]); }
+static uint32_t be32(const uint8_t *p) {
+    return (uint32_t)p[0]<<24 | (uint32_t)p[1]<<16 | (uint32_t)p[2]<<8 | p[3];
+}
+static int header(const uint8_t *h,uint64_t capacity,struct a6_hfs_volume *v) {
+    v->signature=be16(h);v->version=be16(h+2);
+    if (!((v->signature==0x482b && v->version==4) ||
+          (v->signature==0x4858 && v->version==5))) return A6_IO_INVALID;
+    v->attributes=be32(h+4);v->block_size=be32(h+40);v->blocks=be32(h+44);
+    if (v->block_size<512 || v->block_size>1048576 ||
+        (v->block_size&(v->block_size-1)) || !v->blocks || be32(h+48)>v->blocks)
+        return A6_IO_INVALID;
+    v->bytes=(uint64_t)v->block_size*v->blocks;
+    if (v->bytes<4096 || v->bytes>capacity ||
+        ((v->attributes&(1u<<13)) && (!be32(h+12) || be32(h+12)>=v->blocks)))
+        return A6_IO_INVALID;
+    return 0;
+}
+int a6_hfs_volume_check(struct a6_slice *slice,struct a6_hfs_volume *out) {
+    uint8_t bytes[512];struct a6_hfs_volume primary,alternate;
+    if (!out) return A6_IO_INVALID;
+    *out=(struct a6_hfs_volume){0};
+    if (!slice || !slice->disk || slice->count<8 || slice->count>UINT64_MAX/512)
+        return A6_IO_INVALID;
+    int error=a6_slice_io(slice,0,2,1,bytes);
+    if (error) return error;
+    error=header(bytes,slice->count*512,&primary);
+    if (error) return error;
+    /* A copied volume may be smaller than userdata: use its own geometry. */
+    error=a6_slice_io(slice,0,primary.bytes/512-2,1,bytes);
+    if (error) return error;
+    error=header(bytes,slice->count*512,&alternate);
+    if (error || primary.signature!=alternate.signature || primary.version!=alternate.version ||
+        primary.block_size!=alternate.block_size || primary.blocks!=alternate.blocks)
+        return A6_IO_INVALID;
+    *out=primary;
+    return 0;
+}
diff --git c/bsd/dev/a6plte/sdhci.c w/bsd/dev/a6plte/sdhci.c
new file mode 100644
index 0000000..87032ef
--- /dev/null
+++ w/bsd/dev/a6plte/sdhci.c
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* SDHCI 3.0 PIO backend adopting lk2nd's tuned, selected eMMC user area. */
+#include "storage.h"
+enum { BLOCK_SIZE=4,BLOCK_COUNT=6,ARGUMENT=8,TRANSFER=12,COMMAND=14,
+       RESPONSE=16,DATA=32,PRESENT=36,POWER=41,CLOCK=44,TIMEOUT=46,
+       STATUS=48,ERROR=50,ENABLE=52,ERROR_ENABLE=54,SIGNAL=56,ERROR_SIGNAL=58 };
+static uint32_t rd(struct a6_emmc *h,unsigned r,unsigned n) { return h->ops->read(h->cookie,r,n); }
+static void wr(struct a6_emmc *h,unsigned r,unsigned n,uint32_t v) { h->ops->write(h->cookie,r,n,v); }
+static int expired(struct a6_emmc *h,uint64_t start,unsigned ms) {
+    return h->ops->ticks(h->cookie)-start>=h->frequency*ms/1000;
+}
+static int failure(struct a6_emmc *h,int err) { h->online=0;return err; }
+static int wait_bits(struct a6_emmc *h,unsigned reg,unsigned mask,unsigned wanted,unsigned ms) {
+    uint64_t start=h->ops->ticks(h->cookie);
+    for (unsigned tries=0;tries<10000000;++tries) {
+        if (reg==STATUS) {
+            h->last_status=rd(h,STATUS,2);h->last_error=rd(h,ERROR,2);
+            if ((h->last_status&0x8000) || h->last_error) return failure(h,A6_IO_ERROR);
+            if ((h->last_status&mask)==wanted) return 0;
+        } else if ((rd(h,reg,4)&mask)==wanted) return 0;
+        if (expired(h,start,ms)) return failure(h,A6_IO_TIMEOUT);
+    }
+    return failure(h,A6_IO_TIMEOUT);
+}
+static int command(struct a6_emmc *h,unsigned cmd,uint32_t arg,void *buffer,int write,int busy) {
+    h->last_command=cmd;h->last_response=0;h->last_status=0;h->last_error=0;
+    int err=wait_bits(h,PRESENT,buffer || busy ? 3 : 1,0,1000);
+    if (err) return err;
+    wr(h,STATUS,2,0xffff);wr(h,ERROR,2,0xffff);
+    if (buffer) { wr(h,BLOCK_SIZE,2,512);wr(h,BLOCK_COUNT,2,1); }
+    wr(h,TRANSFER,2,buffer ? 2u|(!write?0x10u:0u) : 0); /* One counted block; DMA remains off. */
+    wr(h,ARGUMENT,4,arg);
+    wr(h,COMMAND,2,(cmd<<8)|0x18|(busy?3:2)|(buffer?0x20:0));
+    if ((err=wait_bits(h,STATUS,1,1,1000))) return err;
+    h->last_response=rd(h,RESPONSE,4);wr(h,STATUS,2,1);
+    if (h->last_response&0xffff8080u) return failure(h,A6_IO_ERROR);
+    if (buffer) {
+        unsigned ready=write?0x10:0x20;
+        if ((err=wait_bits(h,STATUS,ready,ready,1000))) return err;
+        uint8_t *p=buffer;
+        for (unsigned i=0;i<512;i+=4) {
+            if (write) {
+                uint32_t v=(uint32_t)p[i]|(uint32_t)p[i+1]<<8|(uint32_t)p[i+2]<<16|(uint32_t)p[i+3]<<24;
+                wr(h,DATA,4,v);
+            } else {
+                uint32_t v=rd(h,DATA,4);
+                p[i]=(uint8_t)v;p[i+1]=(uint8_t)(v>>8);p[i+2]=(uint8_t)(v>>16);p[i+3]=(uint8_t)(v>>24);
+            }
+        }
+        wr(h,STATUS,2,ready);
+    }
+    if (buffer || busy) {
+        if ((err=wait_bits(h,STATUS,2,2,3000))) return err;
+        wr(h,STATUS,2,2);
+    }
+    return 0;
+}
+static int ready(struct a6_emmc *h) {
+    uint64_t start=h->ops->ticks(h->cookie);
+    do {
+        int err=command(h,13,h->rca<<16,NULL,0,0);
+        if (err) return err;
+        unsigned state=(h->last_response>>9)&15;
+        if (state==4 && (h->last_response&0x100)) return 0;
+        if (state!=7 && state!=4) return failure(h,A6_IO_ERROR);
+    } while (!expired(h,start,3000));
+    return failure(h,A6_IO_TIMEOUT);
+}
+int a6_emmc_adopt(struct a6_emmc *h) {
+    if (!h || !h->ops || !h->ops->read || !h->ops->write || !h->ops->ticks ||
+        !h->rca || h->rca>0xffff || h->frequency<1000 || h->frequency>1000000000) return A6_IO_INVALID;
+    h->online=0;h->blocks=0;h->cache_enabled=0;
+    if ((rd(h,CLOCK,2)&7)!=7 || !(rd(h,POWER,1)&1)) return A6_IO_OFFLINE;
+    /* Preserve voltage, DLL/tuning, bus width, clocks and card selection. */
+    wr(h,SIGNAL,2,0);wr(h,ERROR_SIGNAL,2,0);
+    wr(h,ENABLE,2,0x8033);wr(h,ERROR_ENABLE,2,0xffff);wr(h,TIMEOUT,1,0xe);
+    int err=ready(h);
+    if (err) return err;
+    uint8_t ext[512];
+    if ((err=command(h,8,0,ext,0,0))) return err;
+    if ((ext[179]&7) || ext[61] || ext[62] || ext[192]<5) return A6_IO_INVALID;
+    h->blocks=(uint32_t)ext[212]|(uint32_t)ext[213]<<8|(uint32_t)ext[214]<<16|(uint32_t)ext[215]<<24;
+    if (h->blocks<68) return A6_IO_INVALID;
+    h->cache_enabled=ext[33]&1;
+    if (h->cache_enabled && (ext[192]<6 || !(ext[249]|ext[250]|ext[251]|ext[252]))) return A6_IO_INVALID;
+    h->online=1;
+    return 0;
+}
+static int transfer(struct a6_emmc *h,uint64_t lba,uint32_t count,void *buffer,int write) {
+    if (!h || !h->online) return A6_IO_OFFLINE;
+    if (lba>h->blocks || count>h->blocks-lba || (count && !buffer) ||
+        (uint64_t)count>SIZE_MAX/512) return A6_IO_INVALID;
+    uint8_t *p=buffer;
+    for (uint32_t i=0;i<count;++i) {
+        int err=command(h,write?24:17,(uint32_t)(lba+i),p+(size_t)i*512,write,0);
+        if (err) return err; /* Never automatically retry an ambiguous write. */
+        if (write && (err=ready(h))) return err;
+    }
+    return 0;
+}
+int a6_emmc_read(void *h,uint64_t lba,uint32_t count,void *buf) { return transfer(h,lba,count,buf,0); }
+int a6_emmc_write(void *h,uint64_t lba,uint32_t count,const void *buf) { return transfer(h,lba,count,(void *)buf,1); }
+int a6_emmc_flush(void *cookie) {
+    struct a6_emmc *h=cookie;
+    if (!h || !h->online) return A6_IO_OFFLINE;
+    if (h->cache_enabled) {
+        int err=command(h,6,(3u<<24)|(32u<<16)|(1u<<8),NULL,0,1);
+        if (err) return err;
+    }
+    return ready(h);
+}
