+#define aes_ret     void
+#endif
+
+#define aes_rval    aes_ret
+
+typedef struct
+{   aes_32t ks[KS_LENGTH];
+    aes_32t rn;
+} a6_legacy_aes_encrypt_ctx;
+
+typedef struct
+{   aes_32t ks[KS_LENGTH];
+    aes_32t rn;
+} a6_legacy_aes_decrypt_ctx;
+
+#endif
