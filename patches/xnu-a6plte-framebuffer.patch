diff --git i/osfmk/arm/commpage/commpage_asm.s w/osfmk/arm/commpage/commpage_asm.s
index 4a74130..14f1a6b 100644
--- i/osfmk/arm/commpage/commpage_asm.s
+++ w/osfmk/arm/commpage/commpage_asm.s
@@ -275,7 +275,19 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(A6PLTE)
+	// Cortex-A53 has no LSE: acquire the lock using an exclusive pair.
+Ltrylock_enqueue_exclusive:
+	ldaxr w10, [x3]
+	cbnz w10, Ltrylock_enqueue_busy
+	stxr w12, w11, [x3]
+	cbnz w12, Ltrylock_enqueue_exclusive
+	b Ltrylock_enqueue_success
+Ltrylock_enqueue_busy:
+	clrex
+#else
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#endif
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -325,7 +337,19 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if defined(A6PLTE)
+	// Cortex-A53 has no LSE: acquire the lock using an exclusive pair.
+Ltrylock_dequeue_exclusive:
+	ldaxr w10, [x2]
+	cbnz w10, Ltrylock_dequeue_busy
+	stxr w12, w11, [x2]
+	cbnz w12, Ltrylock_dequeue_exclusive
+	b Ltrylock_dequeue_success
+Ltrylock_dequeue_busy:
+	clrex
+#else
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
