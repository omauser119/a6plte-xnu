diff --git i/iokit/Kernel/arm/A6PLTEPlatformExpert.cpp w/iokit/Kernel/arm/A6PLTEPlatformExpert.cpp
new file mode 100644
index 0000000..a7e3211
--- /dev/null
+++ w/iokit/Kernel/arm/A6PLTEPlatformExpert.cpp
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#if A6PLTE
+
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <machine/machine_routines.h>
+#include <pexpert/arm64/board_config.h>
+
+static_assert(MAX_CPUS == 1, "A6PLTE platform expert currently supports the boot CPU only");
+
+/*
+ * The low-level PE code already owns the framebuffer, GICv2 and boot CPU.
+ * This built-in service supplies their board identity to IOKit and publishes
+ * the bridge's CPU/SoC device-tree nodes for subsequent device drivers.
+ */
+class A6PLTEPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(A6PLTEPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *rootEntry) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+};
+
+#define super IODTPlatformExpert
+OSDefineMetaClassAndStructors(A6PLTEPlatformExpert, IODTPlatformExpert);
+
+bool
+A6PLTEPlatformExpert::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+
+	/*
+	 * arm_init already registered the single boot processor and the low-level
+	 * GIC path owns its interrupts. Complete the CPU-discovery contract normally
+	 * supplied by IOCPUInterruptController, so kperf's ml_wait_max_cpus can wake.
+	 */
+	ml_set_max_cpus(MAX_CPUS);
+
+	registerService();
+	IOLog("A6PLTEPlatformExpert: SM-A605FN platform registered\n");
+	return true;
+}
+
+const char *
+A6PLTEPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+A6PLTEPlatformExpert::excludeList(void)
+{
+	/* These are boot metadata, or published separately below. */
+	return "(chosen, cpus, defaults, options, memory-map)";
+}
+
+void
+A6PLTEPlatformExpert::processTopLevel(IORegistryEntry *rootEntry)
+{
+	IOLog("A6PLTEPlatformExpert: publishing CPU and SoC device-tree services\n");
+
+	/*
+	 * IODTPlatformExpert's default implementation requires an /options NVRAM
+	 * service. lk2nd does not supply Apple firmware NVRAM. Keep it absent and
+	 * publish the real nodes without creating an emulated firmware service.
+	 */
+	IORegistryEntry *cpus = rootEntry->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+
+	createNubs(this, IODTFindMatchingEntries(rootEntry, kIODTExclusive, excludeList()));
+}
+
+#endif /* A6PLTE */
