+class A6InputController : public IOService {
+    OSDeclareDefaultStructors(A6InputController);
+    uintptr_t bases[5]={};IOMemoryMap *mappings[5]={};
+    struct a6_input input={};
+    IOWorkLoop *loop=nullptr;IOTimerEventSource *timer=nullptr;
+    A6Digitizer *digitizer=nullptr;A6Buttons *buttons=nullptr;
+    bool running=false;unsigned touchLogs=0;
+    static uint32_t read(void *,unsigned,unsigned);
+    static void write(void *,unsigned,unsigned,uint32_t);
+    static uint64_t us(void *);
+    static void delay(void *,unsigned);
+    static void poll(OSObject *,IOTimerEventSource *);
+    void update(unsigned);
+public:
+    bool start(IOService *) APPLE_KEXT_OVERRIDE;
+    void stop(IOService *) APPLE_KEXT_OVERRIDE;
+    void free() APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(A6InputController,IOService);
+static const unsigned regionSizes[5]={0x100000,0x50000,0x1000,0x1000,0x800000};
+uint32_t A6InputController::read(void *context,unsigned region,unsigned reg) {
+    auto self=(A6InputController *)context;
+    if(region>=5 || reg%4 || reg>regionSizes[region]-4 || !self->bases[region])panic("A6 input MMIO read bounds");
+    uint32_t value=*(volatile uint32_t *)(self->bases[region]+reg);__asm__ volatile("dsb sy" ::: "memory");return value;
+}
+void A6InputController::write(void *context,unsigned region,unsigned reg,uint32_t value) {
+    auto self=(A6InputController *)context;
+    if(region>=5 || reg%4 || reg>regionSizes[region]-4 || !self->bases[region] || region==A6_INPUT_SPMI ||
+        (region==A6_INPUT_OBSERVER && ((reg%0x8000)!=0 || value!=((1u<<27)|(0x10u<<4)))))
+        panic("A6 input MMIO write bounds");
+    *(volatile uint32_t *)(self->bases[region]+reg)=value;__asm__ volatile("dsb sy" ::: "memory");
+}
+uint64_t A6InputController::us(void *) {
+    uint64_t t;__asm__ volatile("mrs %0,cntpct_el0":"=r"(t));
+    return (t/19200000)*1000000+(t%19200000)*1000000/19200000;
+}
+void A6InputController::delay(void *,unsigned us) { IODelay(us); }
+bool A6InputController::start(IOService *provider) {
+    if(!IOService::start(provider))return false;
+    static const uintptr_t addresses[5]={0x01000000,0x01800000,0x078b6000,0x0200f000,0x02c00000};
+    for(unsigned i=0;i<5;++i) {
+        auto memory=IODeviceMemory::withRange(addresses[i],regionSizes[i]);if(!memory)return false;
+        mappings[i]=memory->map();memory->release();
+        if(!mappings[i] || !(bases[i]=mappings[i]->getVirtualAddress()))return false;
+    }
+    struct a6_input_bus bus={this,read,write,us,delay};
+    int result=a6_input_init(&input,&bus);
+    IOLog("A6PLTE input: S6SY761 %s, raw %ux%u, PON %s; command %x reg %x value %x\n",
+        result?"probe failed":"ready",input.max_x,input.max_y,input.pon_ready?"mapped":"unavailable",input.command,input.error_register,input.error_value);
+    digitizer=new A6Digitizer;buttons=new A6Buttons;
+    if(!digitizer || !buttons || !digitizer->init() || !buttons->init())return false;
+    digitizer->touch=true;
+    if(!digitizer->attach(this) || !digitizer->start(this) || !buttons->attach(this) || !buttons->start(this))return false;
+    digitizer->setProperty("A6TouchHardwareReady",input.touch_ready!=0);
+    digitizer->setProperty("A6SensorMaxX",input.max_x,32);digitizer->setProperty("A6SensorMaxY",input.max_y,32);
+    buttons->setProperty("A6PONMapped",input.pon_ready!=0);
+    update(15);digitizer->registerService();buttons->registerService();
+    loop=IOWorkLoop::workLoop();timer=IOTimerEventSource::timerEventSource(this,poll);
+    if(!loop || !timer || loop->addEventSource(timer)!=kIOReturnSuccess)return false;
+    running=true;timer->setTimeoutMS(8);registerService();return true;
+}
+void A6InputController::update(unsigned changes) {
+    uint8_t data[A6_HID_PACKET_MAX];uint64_t time=mach_absolute_time();
+    if(changes&1) {
+        size_t n=a6_hid_touch_packet(data,sizeof(data),time,digitizer->getRegistryEntryID(),&input);
+        if(n)digitizer->publish(0,data,(uint32_t)n);
+        if(input.changed && touchLogs<24) {IOLog("A6PLTE touch: contacts changed %x\n",input.changed);++touchLogs;}
+        input.changed=0;
+    }
+    for(unsigned i=0;i<3;++i)if(changes&(2u<<i)) {
+        size_t n=a6_hid_key_packet(data,sizeof(data),time,buttons->getRegistryEntryID(),i,(input.buttons>>i)&1);
+        buttons->publish(i+1,data,(uint32_t)n);
+        IOLog("A6PLTE button: %s %s\n",i==0?"volume-up":i==1?"volume-down":"power",input.buttons&(1u<<i)?"down":"up");
+    }
+}
+void A6InputController::poll(OSObject *owner,IOTimerEventSource *source) {
+    auto self=OSDynamicCast(A6InputController,owner);if(!self || !self->running)return;
+    unsigned changes=(unsigned)a6_input_poll(&self->input);if(changes)self->update(changes);
+    self->digitizer->flushClients();self->buttons->flushClients();source->setTimeoutMS(8);
+}
+void A6InputController::stop(IOService *provider) {
+    running=false;if(timer)timer->cancelTimeout();
+    if(timer && loop)loop->removeEventSource(timer);
+    if(digitizer)digitizer->terminate();if(buttons)buttons->terminate();IOService::stop(provider);
+}
+void A6InputController::free() {
+    if(timer) {timer->cancelTimeout();if(loop)loop->removeEventSource(timer);timer->release();}
+    if(loop)loop->release();
+    if(digitizer) {if(digitizer->getProvider()==this)digitizer->detach(this);digitizer->release();}
+    if(buttons) {if(buttons->getProvider()==this)buttons->detach(this);buttons->release();}
+    for(unsigned i=0;i<5;++i)if(mappings[i])mappings[i]->release();
+    IOService::free();
+}
+void a6_start_input(IOService *provider) {
+    auto service=new A6InputController;if(!service)return;
+    bool attached=false;
+    if(!service->init() || !(attached=service->attach(provider)) || !service->start(provider)) {
+        IOLog("A6PLTE: input controller start failed\n");if(attached)service->detach(provider);
+    }
+    service->release();
+}
+#endif
diff --git c/iokit/Kernel/arm/A6HIDWire.c w/iokit/Kernel/arm/A6HIDWire.c
new file mode 100644
index 0000000..3d88630
--- /dev/null
+++ w/iokit/Kernel/arm/A6HIDWire.c
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#include "A6HIDWire.h"
+_Static_assert(sizeof(struct a6_hid_header)==28,"IOHID queue header");
+_Static_assert(sizeof(struct a6_hid_key)==32,"IOHID keyboard event");
+_Static_assert(sizeof(struct a6_hid_digitizer)==104,"IOHID digitizer event");
+static void copy(void *target,const void *source,size_t n) {
+    uint8_t *d=target;const uint8_t *s=source;while(n--)*d++=*s++;
+}
+size_t a6_hid_key_packet(void *out,size_t cap,uint64_t time,uint64_t sender,unsigned key,int down) {
+    static const uint16_t usages[3]={0xe9,0xea,0x30};
+    if (!out || cap<60 || key>=3 || (down!=0 && down!=1)) return 0;
+    struct a6_hid_header h={time,sender,0,0,1};
+    struct a6_hid_key k={.base={.size=32,.type=3},.page=0x0c,.usage=usages[key],.down=(uint32_t)down};
+    copy(out,&h,sizeof(h));copy((uint8_t *)out+sizeof(h),&k,sizeof(k));return 60;
+}
+size_t a6_hid_touch_packet(void *out,size_t cap,uint64_t time,uint64_t sender,const struct a6_input *input) {
+    if (!out || !input || !input->max_x || !input->max_y) return 0;
+    unsigned n=0,active=0;for(unsigned i=0;i<10;++i) {
+        n+=input->fingers[i].active || (input->changed&(1u<<i));active+=input->fingers[i].active!=0;
+    }
+    size_t size=28+(n+1)*104;if(cap<size)return 0;
+    struct a6_hid_header h={time,sender,0,0,n+1};copy(out,&h,sizeof(h));
+    struct a6_hid_digitizer root={.base={.size=104,.type=11,.options=(1u<<1)|(1u<<19)},
+        .transducer=3,.mask=7,.child_mask=7};
+    if(active)root.base.options|=(1u<<16)|(1u<<17);
+    copy((uint8_t *)out+28,&root,sizeof(root));size_t at=28+104;
+    for(unsigned i=0;i<10;++i) {
+        const struct a6_finger *f=&input->fingers[i];if(!f->active && !(input->changed&(1u<<i)))continue;
+        struct a6_hid_digitizer d={.base={.size=104,.type=11,.options=1u<<19,.depth=1},
+            .x=(int32_t)((uint64_t)f->x*65536/input->max_x),
+            .y=(int32_t)((uint64_t)f->y*65536/input->max_y),.index=i+1,.transducer=2,.identity=i+1,
+            .mask=7,.pressure=f->active?(int32_t)((unsigned)f->pressure*65536/63):0};
+        if(f->active)d.base.options|=(1u<<16)|(1u<<17);
+        copy((uint8_t *)out+at,&d,sizeof(d));at+=sizeof(d);
+    }
+    return size;
+}
