diff --git i/pexpert/arm/a6plte/gic.c w/pexpert/arm/a6plte/gic.c
new file mode 100644
index 0000000..cfe3527
--- /dev/null
+++ w/pexpert/arm/a6plte/gic.c
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#if defined(A6PLTE)
+#include "gic.h"
+int a6_gic_init(struct a6_gic *g) {
+    if(!g || !g->dist || !g->cpu || !g->read || !g->write || !g->barrier) return -1;
+    g->lines=32*((g->read(g->dist+4)&31)+1);
+    if(g->lines>1020) g->lines=1020;
+    /* Non-secure view: Group 1 only. Never change secure interrupt ownership. */
+    g->write(g->cpu,0);
+    for(unsigned i=0;i<g->lines;i+=32) {
+        g->write(g->dist+0x180+(i/32)*4,~0u);
+        g->write(g->dist+0x280+(i/32)*4,~0u);
+    }
+    /* Virtual timer is level-sensitive. PPI configuration may be read-only. */
+    uint32_t cfg=g->read(g->dist+0xc04);
+    cfg&=~(2u<<((A6_VTIMER_IRQ-16)*2));
+    g->write(g->dist+0xc04,cfg);
+    uintptr_t pri=g->dist+0x400+(A6_VTIMER_IRQ&~3u);
+    unsigned shift=(A6_VTIMER_IRQ%4)*8;
+    uint32_t val=g->read(pri);
+    g->write(pri,(val&~(255u<<shift))|(0x80u<<shift));
+    g->write(g->cpu+4,0xff); /* priority mask */
+    g->write(g->cpu+8,0);    /* binary point */
+    g->write(g->dist+0x100,1u<<A6_VTIMER_IRQ);
+    g->barrier();
+    g->write(g->dist,g->read(g->dist)|1u);
+    /* EOImodeNS=0: EOIR performs both priority drop and deactivation. */
+    g->write(g->cpu,1);
+    g->barrier();
+    return 0;
+}
+unsigned a6_gic_ack(struct a6_gic *g,uint32_t *token) {
+    *token=g->read(g->cpu+0x0c);
+    return *token&1023;
+}
+void a6_gic_end(struct a6_gic *g,uint32_t token) {
+    if((token&1023)>=1020) return;
+    g->barrier();
+    g->write(g->cpu+0x10,token); /* preserve SGI source CPU bits */
+    g->barrier();
+}
+void a6_gic_mask(struct a6_gic *g,unsigned irq) {
+    if(irq>=g->lines) return;
+    g->write(g->dist+0x180+(irq/32)*4,1u<<(irq%32));
+    g->barrier();
+}
+#endif
