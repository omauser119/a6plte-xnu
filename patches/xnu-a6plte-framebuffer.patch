+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Scalar SHA-1 for the native ccdigest ABI when no corecrypto kext is loaded. */
+#include <corecrypto/ccdigest.h>
+#include <corecrypto/ccsha1.h>
+
+void ccdigest_final_64be(const struct ccdigest_info *, ccdigest_ctx_t,
+    unsigned char *);
+
+static const uint32_t initial_state[5] = {
+    0x67452301U, 0xefcdab89U, 0x98badcfeU, 0x10325476U, 0xc3d2e1f0U,
+};
+
+static uint32_t
+rol(uint32_t value, unsigned bits)
+{
+    return (value << bits) | (value >> (32 - bits));
+}
+
+static void
+compress(ccdigest_state_t state, size_t blocks, const void *data)
+{
+    uint32_t *h = ccdigest_u32(state);
+    const uint8_t *p = data;
+
+    while (blocks--) {
+        uint32_t w[16];
+        for (unsigned i = 0; i < 16; ++i) {
+            w[i] = (uint32_t)p[4 * i] << 24 |
+                (uint32_t)p[4 * i + 1] << 16 |
+                (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];
+        }
+        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
+        for (unsigned i = 0; i < 80; ++i) {
+            if (i >= 16) {
+                w[i & 15] = rol(w[(i - 3) & 15] ^ w[(i - 8) & 15] ^
+                    w[(i - 14) & 15] ^ w[i & 15], 1);
+            }
+            uint32_t f, k;
+            if (i < 20) {
+                f = (b & c) | (~b & d); k = 0x5a827999U;
+            } else if (i < 40) {
+                f = b ^ c ^ d; k = 0x6ed9eba1U;
+            } else if (i < 60) {
+                f = (b & c) | (b & d) | (c & d); k = 0x8f1bbcdcU;
+            } else {
+                f = b ^ c ^ d; k = 0xca62c1d6U;
+            }
+            uint32_t next = rol(a, 5) + f + e + k + w[i & 15];
+            e = d; d = c; c = rol(b, 30); b = a; a = next;
+        }
+        h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;
+        cc_clear(sizeof(w), w);
+        p += CCSHA1_BLOCK_SIZE;
+    }
+}
+
+const struct ccdigest_info ccsha1_ltc_di = {
+    .output_size = CCSHA1_OUTPUT_SIZE,
+    .state_size = CCSHA1_STATE_SIZE,
+    .block_size = CCSHA1_BLOCK_SIZE,
+    .oid_size = ccoid_sha1_len,
+    .oid = CC_DIGEST_OID_SHA1,
+    .initial_state = initial_state,
+    .compress = compress,
+    .final = ccdigest_final_64be,
+    .impl = CC_IMPL_SHA1_LTC,
+};
