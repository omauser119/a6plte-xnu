+bool IOSurfaceRoot::start(IOService *provider) {
+    if (!IOService::start(provider) || !(quotaLock=IOLockAlloc())) return false;
+    setName("IOSurfaceRoot");identify(this,"CPU shared-memory surfaces");
+    setProperty("A6SurfaceMaxBytes",A6_SURFACE_MAX_BYTES,64);
+    setProperty("A6SurfacePoolBytes",A6_SURFACE_POOL_BYTES,64);
+    setProperty("A6GPUAcceleration",false);
+    /* Native allocation and zeroing smoke check, with no user mapping yet. */
+    A6SurfaceMemory *test=A6SurfaceMemory::allocate(this,4096);
+    if (!test) return false;
+    volatile uint8_t *bytes=(volatile uint8_t *)test->getBytesNoCopy();
+    bytes[0]=0x53;bytes[4095]=0x46;
+    bool passed=bytes[0]==0x53 && bytes[4095]==0x46;
+    bzero(test->getBytesNoCopy(),4096);test->release();
+    if (!passed) return false;
+    setProperty("A6BufferAllocationSelfTest",true);
+    registerService();
+    IOLog("IOSurfaceRoot: CPU buffers ready, allocation self-test passed; A6 ABI v1\n");
+    ready(A6_READY_SURFACES);
+    return true;
+}
+void IOSurfaceRoot::free() { if (quotaLock) IOLockFree(quotaLock);IOService::free(); }
+bool IOSurfaceRoot::reserve(uint64_t bytes) {
+    IOLockLock(quotaLock);
+    bool ok=bytes && bytes<=A6_SURFACE_MAX_BYTES && charged<=A6_SURFACE_POOL_BYTES-bytes;
+    if (ok) { charged+=bytes;setProperty("A6AllocatedBytes",charged,64); }
+    IOLockUnlock(quotaLock);return ok;
+}
+void IOSurfaceRoot::unreserve(uint64_t bytes) {
+    IOLockLock(quotaLock);charged-=bytes;setProperty("A6AllocatedBytes",charged,64);IOLockUnlock(quotaLock);
+}
+A6SurfaceMemory *A6SurfaceMemory::allocate(IOSurfaceRoot *owner,uint64_t bytes) {
+    if (!owner->reserve(bytes)) return nullptr;
+    A6SurfaceMemory *memory=new A6SurfaceMemory;
+    if (!memory) { owner->unreserve(bytes);return nullptr; }
+    memory->root=owner;owner->retain();memory->charge=bytes;
+    if (!memory->initWithPhysicalMask(kernel_task,IOOptionBits(kIODirectionInOut) | IOOptionBits(kIOMemoryKernelUserShared),bytes,4096,0)) {
+        memory->release();return nullptr;
+    }
+    bzero(memory->getBytesNoCopy(),bytes);
+    return memory;
+}
+void A6SurfaceMemory::free() {
+    if (root) { root->unreserve(charge);root->release();root=nullptr; }
+    IOBufferMemoryDescriptor::free();
+}
+bool IOMobileFramebuffer::start(IOService *provider) {
+    if (!IOService::start(provider) || !a6_xnu_get_display(&display) || !(blitLock=IOLockAlloc())) return false;
+    setName("IOMobileFramebuffer");identify(this,"lk2nd inherited scanout, CPU blit");
+    setProperty("IOFBWidth",display.info.width,32);setProperty("IOFBHeight",display.info.height,32);
+    setProperty("IOFBRowBytes",display.info.stride,32);setProperty("IOFBDepth",display.info.bits_per_pixel,32);
+    setProperty("IOFBMemorySize",display.info.size,64);
+    setProperty("A6PageFlipSupported",false);setProperty("A6VBlankInterruptSupported",false);
+    setProperty("A6ReadOnlyApertureMapping",true);
+    setProperty("DisplayWidth",display.info.width,32);setProperty("DisplayHeight",display.info.height,32);
+    setProperty("ProductName","Samsung Galaxy A6+");
+    pending=(uint8_t *)IOMallocData(display.info.size);
+    presentLoop=IOWorkLoop::workLoop();
+    presentTimer=IOTimerEventSource::timerEventSource(this,present);
+    if (!pending || !presentLoop || !presentTimer || presentLoop->addEventSource(presentTimer)!=kIOReturnSuccess) return false;
+    const volatile uint8_t *front=(const volatile uint8_t *)(uintptr_t)display.virtual_address;
+    for (uint64_t i=0;i<display.info.size;++i) pending[i]=front[i];
+    uint32_t hz=10;
+    if (!PE_parse_boot_argn("a6_fb_hz",&hz,sizeof(hz))) PE_parse_boot_argn("sweetfb_hz",&hz,sizeof(hz));
+    if (!hz || hz>60) hz=60;
+    presentMS=(1000+hz-1)/hz;setProperty("A6PresentHz",hz,32);
+    presentTimer->setTimeoutMS(presentMS);
+    registerService();
+    IOLog("IOMobileFramebuffer: %ux%u, stride %u, %u bpp; A6 ABI v1\n",
+        display.info.width,display.info.height,display.info.stride,display.info.bits_per_pixel);
+    ready(A6_READY_DISPLAY);
+    return true;
+}
+void IOMobileFramebuffer::free() {
+    if (presentTimer) {
+        presentTimer->cancelTimeout();if (presentLoop) presentLoop->removeEventSource(presentTimer);
+        presentTimer->release();
+    }
+    if (presentLoop) presentLoop->release();
+    if (pending) IOFreeData(pending,display.info.size);
+    if (blitLock) IOLockFree(blitLock);IOService::free();
+}
+void IOMobileFramebuffer::present(OSObject *owner,IOTimerEventSource *timer) {
+    IOMobileFramebuffer *self=OSDynamicCast(IOMobileFramebuffer,owner);
+    if (!self) return;
+    IOLockLock(self->blitLock);
+    if (self->dirty) {
+        unsigned bpp=self->display.info.bits_per_pixel/8;
+        volatile uint8_t *front=(volatile uint8_t *)(uintptr_t)self->display.virtual_address;
+        for (uint64_t row=self->top;row<self->bottom;++row) {
+            uint64_t begin=row*self->display.info.stride+self->left*bpp;
+            uint64_t end=row*self->display.info.stride+self->right*bpp;
+            for (uint64_t i=begin;i<end;++i) front[i]=self->pending[i];
+        }
+        __asm__ volatile("dsb sy" ::: "memory");self->dirty=false;
+    }
+    IOLockUnlock(self->blitLock);timer->setTimeoutMS(self->presentMS);
+}
+IOReturn IOMobileFramebuffer::blit(const uint64_t *v,const uint8_t *data,uint32_t bytes) {
+    if (!a6_display_rectangle(&display.info,v[0],v[1],v[2],v[3],v[4],bytes)) return kIOReturnBadArgument;
+    unsigned bpp=display.info.bits_per_pixel/8;
+    IOLockLock(blitLock);
+    uint8_t *destination=pending;
+    for (uint64_t row=0;row<v[3];++row) {
+        uint64_t offset=(v[1]+row)*display.info.stride+v[0]*bpp;
+        for (uint64_t col=0;col<v[2]*bpp;++col) destination[offset+col]=data[row*v[4]+col];
+    }
+    if (!dirty) { left=v[0];top=v[1];right=v[0]+v[2];bottom=v[1]+v[3]; }
+    else {
+        if (v[0]<left) left=v[0];if (v[1]<top) top=v[1];
+        if (v[0]+v[2]>right) right=v[0]+v[2];if (v[1]+v[3]>bottom) bottom=v[1]+v[3];
+    }
+    dirty=true;
+    IOLockUnlock(blitLock);return kIOReturnSuccess;
+}
