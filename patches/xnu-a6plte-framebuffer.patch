+    unsigned last_command, online, cache_enabled;
+};
+int a6_emmc_adopt(struct a6_emmc *);
+int a6_emmc_read(void *, uint64_t, uint32_t, void *);
+int a6_emmc_write(void *, uint64_t, uint32_t, const void *);
+int a6_emmc_flush(void *);
+uintptr_t a6_emmc_map_sdhci(void);
