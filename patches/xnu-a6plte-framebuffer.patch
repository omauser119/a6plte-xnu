diff --git c/pexpert/arm/a6plte/fb.c w/pexpert/arm/a6plte/fb.c
new file mode 100644
index 0000000..b2dc3e1
--- /dev/null
+++ w/pexpert/arm/a6plte/fb.c
@@ -0,0 +1,93 @@
+#if defined(A6PLTE)
+/* SPDX-License-Identifier: BSD-2-Clause */
+#include "fb.h"
+#include "font5x12.h"
+/* Single boot CPU, no allocation, no libc, no UART, byte stores (Device memory safe). */
+#define SCALE 3u
+#define CW (6u * SCALE)
+#define CH (12u * SCALE)
+static unsigned bpp(uint32_t f) { return f == A6_RGB888 ? 3 : f == A6_XRGB8888 ? 4 : f == A6_RGB565 ? 2 : 0; }
+static void barrier(void) {
+#ifdef __aarch64__
+    __asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+typedef uint64_t a6_word __attribute__((__may_alias__));
+static void clear_bytes(volatile uint8_t *dst, uint64_t n) {
+    while (n && ((uintptr_t)dst & 7)) { *dst++=0; --n; }
+    while (n>=8) { *(volatile a6_word *)dst=0; dst+=8; n-=8; }
+    while (n--) *dst++=0;
+}
+static void scroll_bytes(volatile uint8_t *dst, const volatile uint8_t *src, uint64_t n) {
+    /* Forward memmove: the source is at a higher address than the destination.
+     * Naturally aligned scalar accesses are valid for Device memory too. */
+    if ((((uintptr_t)dst ^ (uintptr_t)src) & 7)==0) {
+        while (n && ((uintptr_t)dst & 7)) { *dst++=*src++; --n; }
+        while (n>=8) {
+            *(volatile a6_word *)dst=*(const volatile a6_word *)src;
+            dst+=8; src+=8; n-=8;
+        }
+    }
+    while (n--) *dst++=*src++;
+}
+int a6_fb_init(struct a6_fb *f, uintptr_t base, uint64_t size,
+               uint32_t w, uint32_t h, uint32_t stride, uint32_t format) {
+    unsigned p = bpp(format);
+    if (!base || !p || w < CW || h < CH || w > 8192 || h > 8192 ||
+        stride < (uint64_t)w*p || stride > 65536 || size < (uint64_t)stride*h ||
+        size > UINTPTR_MAX - base) return -1;
+    *f = (struct a6_fb){(volatile uint8_t *)base, size, w, h, stride, format, 0, 0};
+    return 0;
+}
+void a6_fb_clear(struct a6_fb *f) {
+    if (!f->base) return;
+    clear_bytes(f->base,(uint64_t)f->stride*f->height);
+    f->x=f->y=0;
+    barrier();
+}
+static void pixel(struct a6_fb *f, uint32_t x, uint32_t y, int on) {
+    if (x>=f->width || y>=f->height) return;
+    volatile uint8_t *p = f->base + (uint64_t)y*f->stride + x*bpp(f->format);
+    /* White on black deliberately avoids any RGB/BGR ambiguity in first-stage logs. */
+    for (unsigned k=0; k<bpp(f->format); ++k) p[k]=on ? 255 : 0;
+}
+static void newline(struct a6_fb *f) {
+    f->x=0;
+    uint32_t rows=f->height/CH;
+    if (f->y < rows-1) { ++f->y; return; }
+    /* Reading the inherited Device-memory framebuffer is expensive.  Leave
+     * room for eight more lines per full-screen move on a tall display. */
+    uint32_t drop=rows>=16?8:1;
+    /* Keep the cursor in range even while the long pixel move is in progress. */
+    f->y=rows-drop;
+    uint64_t line=(uint64_t)CH*f->stride, used=(uint64_t)rows*line, shift=drop*line;
+    scroll_bytes(f->base,f->base+shift,used-shift);
+    clear_bytes(f->base+used-shift,shift);
+}
+void a6_fb_putc(struct a6_fb *f, char ch) {
+    if (!f->base) return;
+    unsigned c=(unsigned char)ch;
+    if (c=='\r') f->x=0;
+    else if (c=='\n') newline(f);
+    else if (c=='\t') { unsigned n=4-(f->x%4); while(n--) a6_fb_putc(f,' '); }
+    else if(c=='\b') { if(f->x) --f->x; }
+    else {
+        if(c<32 || c>126) c='?';
+        for(unsigned y=0;y<12;++y) {
+            uint32_t bits=font5x12[(c-32)*2+y/6] >> ((y%6)*5);
+            for(unsigned x=0;x<6;++x)
+                for(unsigned sy=0;sy<SCALE;++sy)
+                    for(unsigned sx=0;sx<SCALE;++sx)
+                        pixel(f,f->x*CW+x*SCALE+sx,f->y*CH+y*SCALE+sy,x<5 && ((bits>>x)&1));
+        }
+        if(++f->x >= f->width/CW) newline(f);
+    }
+    barrier();
+}
+void a6_fb_puts(struct a6_fb *f,const char *s) { while(*s) a6_fb_putc(f,*s++); }
+void a6_fb_hex(struct a6_fb *f,uint64_t n) {
+    a6_fb_puts(f,"0x");
+    for(int i=60;i>=0;i-=4) a6_fb_putc(f,"0123456789abcdef"[(n>>i)&15]);
+}
+
+#endif
