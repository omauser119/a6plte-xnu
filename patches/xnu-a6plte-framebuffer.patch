+class A6HIDEventClient : public IOUserClient {
+    OSDeclareDefaultStructors(A6HIDEventClient);
+    IOHIDEventService *owner=nullptr;
+    IOSharedDataQueue *queue=nullptr;IOLock *lock=nullptr;mach_port_t notification=MACH_PORT_NULL;
+    bool opened=false,closed=false,registered=false;
+    uint8_t pending[4][A6_HID_PACKET_MAX]={};uint32_t lengths[4]={};
+    void flushLocked();
+public:
+    bool start(IOService *) APPLE_KEXT_OVERRIDE;
+    void stop(IOService *) APPLE_KEXT_OVERRIDE;
