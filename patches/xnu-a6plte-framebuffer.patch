+static LCK_GRP_DECLARE(a6_boot_random_group, "a6plte-bootstrap-random");
+static LCK_SPIN_DECLARE(a6_boot_random_lock, &a6_boot_random_group);
+static SECURITY_READ_ONLY_LATE(bool) a6_boot_random_lock_ready;
