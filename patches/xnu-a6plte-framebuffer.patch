+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Public Apple IOHID event queue representation, implemented independently.
+ * Reference: IOHIDFamily 2365347f5147a1e2a46de21acd08d27fe0906e85. */
+struct __attribute__((packed,aligned(4))) a6_hid_header {
+    uint64_t timestamp,sender;uint32_t options,attributes,count;
+};
+struct a6_hid_base { uint32_t size,type,options;uint8_t depth,reserved[3]; };
+struct a6_hid_key { struct a6_hid_base base;uint16_t page,usage;uint32_t down,flags;uint8_t press_count,reserved[3]; };
+struct a6_hid_digitizer {
+    struct a6_hid_base base;int32_t x,y,z;
+    uint32_t index,transducer,identity,mask,child_mask,buttons;
+    int32_t pressure,aux_pressure,twist;uint32_t orientation_type;
+    int32_t orientation[6];uint32_t generation,will_update,did_update;
+};
+#define A6_HID_PACKET_MAX (28+11*104)
+size_t a6_hid_key_packet(void *,size_t,uint64_t,uint64_t,unsigned,int);
+size_t a6_hid_touch_packet(void *,size_t,uint64_t,uint64_t,const struct a6_input *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git c/iokit/Kernel/arm/A6Input.c w/iokit/Kernel/arm/A6Input.c
new file mode 100644
index 0000000..8b94ce1
--- /dev/null
+++ w/iokit/Kernel/arm/A6Input.c
@@ -0,0 +1,197 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Original polled QUPv2/S6SY761 + TLMM/PM8953 PON driver. Register/protocol
+ * definitions verified against upstream hardware drivers; no firmware writes,
+ * DMA, PMIC power/reset writes, or UART access. */
+#include "A6Input.h"
+static uint32_t probe_register,probe_value,probe_command;
+void a6_input_probe_status(uint32_t *reg,uint32_t *value,uint32_t *command) {
+    *reg=probe_register;*value=probe_value;*command=probe_command;
+}
+static uint32_t rd(struct a6_input *s,unsigned region,unsigned reg) { return s->bus.read(s->bus.context,region,reg); }
+static void wr(struct a6_input *s,unsigned region,unsigned reg,uint32_t value) { s->bus.write(s->bus.context,region,reg,value); }
+static int wait_bits(struct a6_input *s,unsigned region,unsigned reg,uint32_t mask,uint32_t wanted,unsigned timeout) {
+    uint64_t start=s->bus.us(s->bus.context);uint32_t v;
+    do {
+        v=rd(s,region,reg);if ((v&mask)==wanted) return 0;
+        s->bus.delay(s->bus.context,2);
+    } while (s->bus.us(s->bus.context)-start<timeout);
+    s->error_register=(region<<24)|reg;s->error_value=v;return -1;
+}
+static int state(struct a6_input *s,unsigned next) {
+    if (wait_bits(s,A6_INPUT_QUP,4,4,4,1000)) return -1;
+    wr(s,A6_INPUT_QUP,4,next);
+    return wait_bits(s,A6_INPUT_QUP,4,7,4|next,1000);
+}
+static void pin(struct a6_input *s,unsigned gpio,unsigned function,unsigned pull,unsigned output) {
+    unsigned reg=gpio*0x1000;uint32_t value=rd(s,A6_INPUT_TLMM,reg);
+    value=(value&~0x3ffu)|(function<<2)|pull|(output?1u<<9:0);
+    wr(s,A6_INPUT_TLMM,reg,value); /* 2 mA drive; preserve unrelated bits */
+}
+static int qup_reset(struct a6_input *s) {
+    wr(s,A6_INPUT_QUP,0x0c,1);
+    if (wait_bits(s,A6_INPUT_QUP,4,7,4,1000)) return -1;
+    wr(s,A6_INPUT_QUP,0,0x207);
+    wr(s,A6_INPUT_QUP,8,3u<<14);
+    wr(s,A6_INPUT_QUP,0x100,0);wr(s,A6_INPUT_QUP,0x200,0);
+    wr(s,A6_INPUT_QUP,0x1c,0x7c);wr(s,A6_INPUT_QUP,0x404,0x38000fc);
+    wr(s,A6_INPUT_QUP,0x20,0);
+    /* SERVICE masking belongs to BAM/DMA, not this polled FIFO path. */
+    wr(s,A6_INPUT_QUP,0x28,0);wr(s,A6_INPUT_QUP,0x408,1);
+    /* Mini-core selection is asynchronous even after RESET is valid. */
+    return wait_bits(s,A6_INPUT_QUP,4,0x14,0x14,1000);
+}
+/* One short FIFO phase. phase 0 leaves the bus owned for a repeated START. */
+static int phase(struct a6_input *s,const uint8_t *tags,unsigned n,uint8_t *out,unsigned bytes,int first) {
+    uint32_t configure=first?0:1u<<31;
+    wr(s,A6_INPUT_QUP,0x150,configure|n);
+    wr(s,A6_INPUT_QUP,0x208,configure|(bytes?bytes+2:0));
+    wr(s,A6_INPUT_QUP,0,0x207|(bytes?0:0x80));
+    if (first) {
+        if (state(s,1)) return -1;
+        wr(s,A6_INPUT_QUP,0x400,(3u<<8)|93); /* 19.2 MHz -> 100 kHz */
+        if (state(s,3)) return -1;
+    }
+    for (unsigned i=0;i<n;i+=4) {
+        uint32_t value=0;for(unsigned j=0;j<4 && i+j<n;++j)value|=(uint32_t)tags[i+j]<<(j*8);
+        wr(s,A6_INPUT_QUP,0x110,value);
+    }
+    if (state(s,1)) return -1;
+    uint64_t start=s->bus.us(s->bus.context);unsigned received=0;uint8_t raw[16]={0};
+    for (;;) {
+        uint32_t op=rd(s,A6_INPUT_QUP,0x18),status=rd(s,A6_INPUT_QUP,0x404),error=rd(s,A6_INPUT_QUP,0x1c);
+        if ((status&0x38000fcu) || (error&0x7c)) {
+            s->error_register=(status&0x38000fcu)?0x02000404:0x0200001c;
+            s->error_value=(status&0x38000fcu)?status:error;return -1;
+        }
+        if (bytes && received<bytes+2 && (op&(1u<<5))) {
+            uint32_t word=rd(s,A6_INPUT_QUP,0x218);
+            for (unsigned j=0;j<4 && received<bytes+2;++j) raw[received++]=(uint8_t)(word>>(j*8));
+        }
+        /* In FIFO mode OUTPUT_SERVICE can precede MAX_OUTPUT_DONE. Waiting
+         * only for DONE after acknowledging SERVICE can hang short writes.
+         * A read is complete once its entire tagged response is drained. */
+        int complete=bytes?received==bytes+2:
+            (op&((1u<<8)|(1u<<10))) && !(op&((1u<<4)|(1u<<6)));
+        if (op&0x300) wr(s,A6_INPUT_QUP,0x18,op&0x300);
+        if (complete) break;
+        if (s->bus.us(s->bus.context)-start>=20000) {
+            s->error_register=0x02000018;s->error_value=op;return -1;
+        }
+        s->bus.delay(s->bus.context,2);
+    }
+    if (bytes) {
+        if ((raw[0]<0x85 || raw[0]>0x87) || raw[1]!=bytes) { s->error_register=0x02000218;s->error_value=raw[0]|(uint32_t)raw[1]<<8;return -1; }
+        for(unsigned i=0;i<bytes;++i)out[i]=raw[i+2];
+    }
+    wr(s,A6_INPUT_QUP,0x18,0x300);
+    return 0;
+}
+static int command(struct a6_input *s,uint8_t cmd,const uint8_t *data,unsigned n,uint8_t *out,unsigned bytes) {
+    if (n>3 || bytes>11 || (n && !data) || (bytes && !out)) return -1;
+    s->command=cmd;
+    s->error_register=s->error_value=0;
+    if (qup_reset(s)) return -1;
+    uint8_t tags[8]={0x81,0x90,bytes?0x82:0x83,(uint8_t)(n+1),cmd,0,0,0};
+    for(unsigned i=0;i<n;++i)tags[5+i]=data[i];
+    int error=phase(s,tags,5+n,0,0,1);
+    if (!error && bytes) {
+        uint8_t read_tags[4]={0x81,0x91,0x87,(uint8_t)bytes};
+        if (state(s,3)) error=-1;
+        else error=phase(s,read_tags,4,out,bytes,0);
+    }
+    /* Receiving the final byte is earlier than STOP reaching the bus. Do
+     * not reset the mini-core while the sensor still owns/finishes a transfer.
+     * Otherwise a later command can stall with OPERATIONAL.OUT_FULL (0x40). */
+    if (!error) error=wait_bits(s,A6_INPUT_QUP,0x404,1u<<8,0,20000);
+    /* Reset on success and failure: never leave the I2C bus claimed. */
+    uint32_t failed_reg=s->error_register,failed_value=s->error_value;
+    if (state(s,0)) error=-1;
+    if (failed_reg) { s->error_register=failed_reg;s->error_value=failed_value; }
+    return error;
+}
+static int pon(struct a6_input *s,uint8_t *value) {
+    unsigned base=s->pon_channel*0x8000;
+    wr(s,A6_INPUT_OBSERVER,base,(1u<<27)|(0x10u<<4)); /* EXT_READL SID0, PID8, RT_STS */
+    if (wait_bits(s,A6_INPUT_OBSERVER,base+8,1,1,1000)) return -1;
+    uint32_t status=rd(s,A6_INPUT_OBSERVER,base+8);
+    if (status&14) { s->error_register=0x04000008|base;s->error_value=status;return -1; }
+    *value=(uint8_t)rd(s,A6_INPUT_OBSERVER,base+0x18);return 0;
+}
+int a6_input_init(struct a6_input *s,const struct a6_input_bus *bus) {
+    if (!s || !bus || !bus->read || !bus->write || !bus->us || !bus->delay) return -1;
+    *s=(struct a6_input){.bus=*bus};
+    pin(s,85,0,3,0); /* volume-up: active-low, pull-up */
+    uint32_t version=rd(s,A6_INPUT_SPMI,0);
+    if (version>=0x20010000 && version<0x50000000) {
+        for (unsigned n=0;n<256;++n) {
+            uint32_t map=rd(s,A6_INPUT_SPMI,0x800+n*4);
+            if (map && ((map>>8)&0xfff)==8) { s->pon_channel=n;s->pon_ready=1;break; }
+        }
+    }
+    /* Turn on only the two clocks and pins belonging to BLSP1 QUP2. */
+    wr(s,A6_INPUT_GCC,0x45004,rd(s,A6_INPUT_GCC,0x45004)|(1u<<10));
+    if (wait_bits(s,A6_INPUT_GCC,0x1008,1u<<31,0,1000)) goto failed;
+    wr(s,A6_INPUT_GCC,0x3004,1); /* XO, divide by one (RCG2 HID=1) */
+    wr(s,A6_INPUT_GCC,0x3000,rd(s,A6_INPUT_GCC,0x3000)|1);
+    if (wait_bits(s,A6_INPUT_GCC,0x3000,1,0,1000)) goto failed;
+    wr(s,A6_INPUT_GCC,0x3010,rd(s,A6_INPUT_GCC,0x3010)|1);
+    if (wait_bits(s,A6_INPUT_GCC,0x3010,1u<<31,0,1000)) goto failed;
+    pin(s,6,3,0,0);pin(s,7,3,0,0);pin(s,59,0,0,0);
+    /* Both fixed touch supplies share GPIO139. Enable without power cycling. */
+    wr(s,A6_INPUT_TLMM,139*0x1000+4,rd(s,A6_INPUT_TLMM,139*0x1000+4)|2);
+    pin(s,139,0,0,1);bus->delay(bus->context,150000);
+    uint8_t id[3],boot=0,integrity=0,panel[11],event[8],enable[2]={1,0};
+    /* Match the sensor's application startup order. Consume the boot event
+     * if present; a warm boot can inherit an already-consumed event queue. */
+    if (command(s,0x60,0,0,event,8) || command(s,0x55,0,0,&boot,1)) goto failed;
+    if (boot!=0x20) { s->error_register=0x05000055;s->error_value=boot;goto failed; }
+    if (command(s,0x30,enable,2,0,0) || command(s,0x52,0,0,id,3)) goto failed;
+    if (command(s,0x23,0,0,panel,11)) goto failed;
+    if (!((unsigned)panel[0]<<8|panel[1]) || !((unsigned)panel[2]<<8|panel[3])) {
+        s->error_register=0x05000023;s->error_value=(uint32_t)panel[0]<<24|(uint32_t)panel[1]<<16|(uint32_t)panel[2]<<8|panel[3];goto failed;
+    }
+    if (command(s,0x21,0,0,&integrity,1)) goto failed;
+    if (integrity!=0x80) { s->error_register=0x05000021;s->error_value=integrity;goto failed; }
+    /* Board DT overrides panel defaults: touchscreen-size-x/y = 4096.
+     * These are sensor units, independent of the 1080x2220 display pixels. */
+    s->max_x=4095;s->max_y=4095;
+    if (command(s,0x62,0,0,0,0) || command(s,0x10,0,0,0,0)) goto failed;
+    s->touch_ready=1;probe_register=probe_value=probe_command=0;return 0;
+failed:
+    probe_register=s->error_register;probe_value=s->error_value;probe_command=s->command;
+    return -1;
+}
+int a6_input_decode(struct a6_input *s,const uint8_t e[8]) {
+    if (!s || !e || !e[0] || (e[0]&3)) return 0;
+    unsigned id=(e[0]>>2)&15,state=e[0]>>6;if (!id || id>10 || !state) return 0;
+    --id;struct a6_finger f={.x=(uint16_t)((unsigned)e[1]<<4|(e[3]>>4)),
+        .y=(uint16_t)((unsigned)e[2]<<4|(e[3]&15)),.active=state!=3,.pressure=e[6]&63,.major=e[4],.minor=e[5]};
+    if (f.x>s->max_x)f.x=(uint16_t)s->max_x;if(f.y>s->max_y)f.y=(uint16_t)s->max_y;
+    s->fingers[id]=f;s->changed|=(uint16_t)(1u<<id);return 1;
+}
+void a6_input_release(struct a6_input *s) {
+    for (unsigned i=0;i<10;++i) if (s->fingers[i].active) { s->fingers[i].active=0;s->changed|=(uint16_t)(1u<<i); }
+}
+int a6_input_poll(struct a6_input *s) {
+    if (!s) return 0;
+    unsigned before=s->buttons,values=(rd(s,A6_INPUT_TLMM,85*0x1000+4)&1)?0:1;
+    uint8_t p=0;int valid=s->pon_ready && !pon(s,&p);
+    if (p&2)values|=2;if(p&1)values|=4;
+    for(unsigned i=0;i<3;++i) {
+        if (i && !valid) continue;
+        uint8_t value=(values>>i)&1;
+        if(s->candidate[i]!=value) {s->candidate[i]=value;s->samples[i]=1;}
+        else if(s->samples[i]<3)++s->samples[i];
+        if(s->samples[i]==3) { s->stable[i]=value;s->buttons=(uint8_t)((s->buttons&~(1u<<i))|((unsigned)value<<i)); }
+    }
+    int result=(int)((before^s->buttons)<<1);
+    if (!s->touch_ready || (rd(s,A6_INPUT_TLMM,59*0x1000+4)&1)) return result;
+    for(unsigned n=0;n<32;++n) {
+        uint8_t e[8];
+        if(command(s,0x60,0,0,e,8)) { a6_input_release(s);return result|1; }
+        if(!e[0])break;
+        if(a6_input_decode(s,e)) result|=1;
+        if(!(e[7]&63))break;
+    }
+    return result;
+}
diff --git c/iokit/Kernel/arm/A6Input.h w/iokit/Kernel/arm/A6Input.h
new file mode 100644
index 0000000..7a4b2dd
--- /dev/null
+++ w/iokit/Kernel/arm/A6Input.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef A6_INPUT_H
+#define A6_INPUT_H
+#include <stdint.h>
+#include <stddef.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum { A6_INPUT_TLMM,A6_INPUT_GCC,A6_INPUT_QUP,A6_INPUT_SPMI,A6_INPUT_OBSERVER };
+struct a6_input_bus {
+    void *context;
+    uint32_t (*read)(void *,unsigned,unsigned);
+    void (*write)(void *,unsigned,unsigned,uint32_t);
+    uint64_t (*us)(void *);
+    void (*delay)(void *,unsigned);
+};
+struct a6_finger { uint16_t x,y; uint8_t active,pressure,major,minor; };
+struct a6_input {
+    struct a6_input_bus bus;
+    struct a6_finger fingers[10];
+    unsigned max_x,max_y;
+    unsigned pon_channel;
+    uint32_t error_register,error_value;
+    uint8_t command;
+    uint8_t touch_ready,pon_ready,buttons,stable[3],candidate[3],samples[3];
+    uint16_t changed;
+};
+int a6_input_init(struct a6_input *,const struct a6_input_bus *);
+int a6_input_poll(struct a6_input *); /* 1 touch change; button changes in bits 1..3 */
+int a6_input_decode(struct a6_input *,const uint8_t event[8]);
+void a6_input_release(struct a6_input *);
+/* Last completed hardware probe only; no live MMIO access or object pointer. */
+void a6_input_probe_status(uint32_t *reg,uint32_t *value,uint32_t *command);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git c/iokit/Kernel/arm/A6KeyStoreState.h w/iokit/Kernel/arm/A6KeyStoreState.h
new file mode 100644
index 0000000..95fa433
--- /dev/null
+++ w/iokit/Kernel/arm/A6KeyStoreState.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef A6_KEYSTORE_STATE_H
+#define A6_KEYSTORE_STATE_H
+#include <stdint.h>
+/* DER SET OF SEQUENCE { UTF8String, INTEGER }, for the no-passcode stub.
+ * Bit 2 means unlocked since boot. No key material is generated or returned.
+ */
+static inline unsigned a6_aks_extended_state(uint8_t *out,unsigned capacity) {
+    static const char keys[][5]={"sb","ss","sas","sfa","sgs","sls","sgpe","srcd"};
+    static const unsigned lengths[]={2,2,3,3,3,3,4,4};
+    unsigned required=2;
+    for (unsigned i=0;i<8;++i) required+=7+lengths[i];
+    if (!out || capacity<required) return 0;
+    unsigned n=0;out[n++]=0x31;out[n++]=(uint8_t)(required-2);
+    for (unsigned i=0;i<8;++i) {
+        out[n++]=0x30;out[n++]=(uint8_t)(5+lengths[i]);
+        out[n++]=0x0c;out[n++]=(uint8_t)lengths[i];
+        for (unsigned j=0;j<lengths[i];++j) out[n++]=(uint8_t)keys[i][j];
+        out[n++]=2;out[n++]=1;out[n++]=(i==1)?4:0;
+    }
+    return n;
+}
+#endif
