diff --git c/osfmk/arm64/a6plte_diagnostics.c w/osfmk/arm64/a6plte_diagnostics.c
new file mode 100644
index 0000000..513b4f1
--- /dev/null
+++ w/osfmk/arm64/a6plte_diagnostics.c
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#if A6PLTE
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/queue.h>
+#include <kern/misc_protos.h>
+#include <vm/vm_map.h>
+#include <vm/vm_shared_region.h>
+#include <arm/thread.h>
+#include <arm64/proc_reg.h>
+
+/* References are captured under the task lock. All pageable memory reads and
+ * framebuffer logging happen after releasing it, so a fault cannot sleep
+ * while holding XNU's task spin lock. Samples show the last saved user state.
+ */
+void a6_sample_task(const char *name,int pid,task_t task) {
+    thread_t captured[64],thread;unsigned n=0;
+    vm_map_t map=get_task_map_reference(task);uint64_t slide=0;
+    if (map==VM_MAP_NULL) return;
+    vm_shared_region_t region=vm_shared_region_get(task);
+    if (region) { slide=region->sr_slide;vm_shared_region_deallocate(region); }
+    task_lock(task);
+    queue_iterate(&task->threads,thread,thread_t,task_threads) {
+        if (n==64) break;
+        thread_reference(thread);captured[n++]=thread;
+    }
+    task_unlock(task);
+    printf("A6PLTE SMP: %s[%d] slide 0x%llx mh 0x%llx, %u threads\n",
+        name,pid,slide,task->mach_header_vm_address,n);
+    for (unsigned i=0;i<n;++i) {
+        arm_thread_state64_t state={0};mach_msg_type_number_t count=ARM_THREAD_STATE64_COUNT;
+        if (thread_getstatus(captured[i],ARM_THREAD_STATE64,(thread_state_t)&state,&count)==KERN_SUCCESS) {
+            char line[480];
+            int used=snprintf(line,sizeof(line),"SMP %s[%d] t%u pc 0x%llx lr 0x%llx sp 0x%llx bt",
+                name,pid,i,state.pc,state.lr,state.sp);
+            uint64_t fp=state.fp;
+            for (unsigned depth=0;depth<16 && fp && !(fp&7) && used>0 && used<(int)sizeof(line)-24;++depth) {
+                uint64_t frame[2];
+                if (vm_map_read_user(map,fp,frame,sizeof(frame))!=KERN_SUCCESS) break;
+                used+=snprintf(line+used,sizeof(line)-(size_t)used," 0x%llx",frame[1]);
+                if (frame[0]<=fp || frame[0]-fp>1024*1024) break;
+                fp=frame[0];
+            }
+            printf("%s\n",line);
+        }
+        thread_deallocate(captured[i]);
+    }
+    vm_map_deallocate(map);
+}
+#endif
diff --git c/osfmk/arm64/a6plte_interrupts.c w/osfmk/arm64/a6plte_interrupts.c
new file mode 100644
index 0000000..473651e
--- /dev/null
+++ w/osfmk/arm64/a6plte_interrupts.c
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#if defined(A6PLTE)
+#include <machine/machine_routines.h>
+#include <kern/debug.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/rtclock.h>
+#include <pexpert/pexpert.h>
+#include "../../pexpert/arm/a6plte/gic.h"
+static struct a6_gic gic;
+static int initialized;
+static unsigned char local_ready[8],targets[8];
+extern void cpu_signal_handler(void);
+extern void a6_smp_local_ready(unsigned);
+static uint32_t mmio_read(uintptr_t a) { return *(volatile uint32_t *)a; }
+static void mmio_write(uintptr_t a,uint32_t v) { *(volatile uint32_t *)a=v; }
+static void sync_io(void) { __asm__ volatile("dsb sy; isb" ::: "memory"); }
+void a6_xnu_interrupt_init(void) {
+    uint64_t mpidr;__asm__ volatile("mrs %0,mpidr_el1":"=r"(mpidr));
+    unsigned cpu=(unsigned)(mpidr&3)+4*(unsigned)((mpidr>>8)&1);
+    if (__atomic_load_n(&local_ready[cpu],__ATOMIC_ACQUIRE)) return;
+    if(!__atomic_load_n(&initialized,__ATOMIC_ACQUIRE)) {
+      gic=(struct a6_gic){.dist=ml_io_map(A6_GICD_PA,0x1000),.cpu=ml_io_map(A6_GICC_PA,0x1000),
+                       .read=mmio_read,.write=mmio_write,.barrier=sync_io};
+      if(a6_gic_init(&gic)) panic("A6PLTE: GICv2 initialization failed");
+      __atomic_store_n(&initialized,1,__ATOMIC_RELEASE);
+    } else if(a6_gic_local_init(&gic)) panic("A6PLTE: per-CPU GIC initialization failed");
+    /* ITARGETSR0 is banked and reports this interface's actual target bit. */
+    unsigned target=mmio_read(gic.dist+0x800)&255;
+    if (!target || (target&(target-1))) panic("A6PLTE: invalid GIC CPU target mask %x",target);
+    __atomic_store_n(&targets[cpu],(unsigned char)target,__ATOMIC_RELEASE);
+    __atomic_store_n(&local_ready[cpu],1,__ATOMIC_RELEASE);
+    a6_smp_local_ready(cpu);
+    kprintf("A6PLTE: CPU%u GICv2 ready; timer IRQ %u, target %x\n",cpu,A6_VTIMER_IRQ,target);
+}
+void a6_xnu_send_ipi(unsigned cpu) {
+    if (cpu>=8 || !__atomic_load_n(&initialized,__ATOMIC_ACQUIRE)) return;
+    a6_gic_send_ipi(&gic,__atomic_load_n(&targets[cpu],__ATOMIC_ACQUIRE));
+}
+void a6_xnu_handle_irq(void) {
+    if(!initialized) panic("A6PLTE: interrupt before GIC initialization");
+    uint32_t token;
+    unsigned irq=a6_gic_ack(&gic,&token);
+    if(irq>=1020) return;
+    if(irq==A6_IPI_IRQ) {
+        a6_gic_end(&gic,token);cpu_signal_handler();return;
+    } else if(irq==A6_VTIMER_IRQ) {
+        getCpuDatap()->cpu_decrementer=-1;
+        rtclock_intr(TRUE);
+    } else {
+        /* No device drivers yet: prevent an inherited pending interrupt storm. */
+        a6_gic_mask(&gic,irq);
+        kprintf("A6PLTE: masked unhandled IRQ %u\n",irq);
+    }
+    a6_gic_end(&gic,token);
+}
+#endif
diff --git c/osfmk/arm64/a6plte_smp.c w/osfmk/arm64/a6plte_smp.c
new file mode 100644
index 0000000..4d81e08
--- /dev/null
+++ w/osfmk/arm64/a6plte_smp.c
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#if A6PLTE
+#include <kern/processor.h>
+#include <kern/debug.h>
+#include <kern/misc_protos.h>
+#include <arm/machine_routines.h>
+#include <arm/cpu_data_internal.h>
+#include <vm/pmap.h>
+#include <pexpert/pexpert.h>
+
+extern void a6_secondary_entry(void);
+extern void a6_xnu_send_ipi(unsigned);
+static uint32_t local_mask;
+/* Written before touching a stack by the physical PSCI entry, for diagnosis. */
+uint32_t a6_secondary_stage[8];
+const char a6_smp_profile[]="A6PLTE Cortex-A53 SMP8 PSCI";
+
+void a6_smp_local_ready(unsigned cpu) {
+    if (cpu<8) __atomic_fetch_or(&local_mask,1u<<cpu,__ATOMIC_RELEASE);
+}
+static int cpu_index(cpu_id_t id) {
+    uintptr_t value=(uintptr_t)id;
+    return value && value<=8?(int)value-1:-1;
+}
+static int64_t psci_cpu_on(uint64_t mpidr,uint64_t entry,uint64_t context) {
+    register uint64_t x0 __asm__("x0")=0xc4000003;
+    register uint64_t x1 __asm__("x1")=mpidr;
+    register uint64_t x2 __asm__("x2")=entry;
+    register uint64_t x3 __asm__("x3")=context;
+    __asm__ volatile("dsb sy\n\tsmc #0" : "+r"(x0),"+r"(x1),"+r"(x2),"+r"(x3) ::
+        "x4","x5","x6","x7","x8","x9","x10","x11","x12","x13","x14","x15","x16","x17","memory");
+    return (int64_t)x0;
+}
+kern_return_t a6_cpu_start(cpu_id_t target) {
+    int n=cpu_index(target);
+    const ml_topology_info_t *topology=ml_get_topology_info();
+    if (n<0 || (unsigned)n>=topology->num_cpus) return KERN_INVALID_ARGUMENT;
+    uint64_t context=(uintptr_t)CpuDataEntries[n].cpu_data_paddr;
+    if (!context) return KERN_FAILURE;
+    int64_t result=psci_cpu_on(topology->cpus[n].phys_id,
+        ml_static_vtop((vm_offset_t)a6_secondary_entry),context);
+    kprintf("A6PLTE CPU%u: PSCI CPU_ON MPIDR %x -> %lld\n",n,topology->cpus[n].phys_id,result);
+    return result==0?KERN_SUCCESS:KERN_FAILURE;
+}
+void a6_cpu_signal(cpu_id_t target) {
+    int n=cpu_index(target);if (n>=0) a6_xnu_send_ipi((unsigned)n);
+}
+void a6_start_other_cpus(void) {
+    if (!ml_get_interrupts_enabled()) panic("A6PLTE: SMP start requires live interrupts");
+    const ml_topology_info_t *topology=ml_get_topology_info();
+    processor_t processors[8]={0};unsigned count=topology->num_cpus;
+    if (count>8) panic("A6PLTE: invalid CPU topology");
+    for (unsigned n=0;n<count;++n) {
+        const ml_topology_cpu_t *cpu=&topology->cpus[n];
+        ml_processor_info_t info={0};ipi_handler_t ipi=NULL;perfmon_interrupt_handler_func pmi=NULL;
+        info.cpu_id=(cpu_id_t)(uintptr_t)(n+1);info.log_id=cpu->cpu_id;info.phys_id=cpu->phys_id;
+        info.cluster_id=cpu->cluster_id;info.cluster_type=cpu->cluster_type;
+        info.l2_cache_id=cpu->l2_cache_id;info.l2_cache_size=cpu->l2_cache_size;
+        kern_return_t result=ml_processor_register(&info,&processors[n],&ipi,&pmi);
+        if (result!=KERN_SUCCESS) panic("A6PLTE: CPU%u registration failed %d",n,result);
+    }
+    ml_set_max_cpus(count);
+    /* Native cpu_machine_init expects a self-IPI to clear SIGPdisabled. */
+    a6_cpu_signal((cpu_id_t)(uintptr_t)(ml_get_boot_cpu_number()+1));
+    for (unsigned n=0;n<count;++n) {
+        if (n==(unsigned)ml_get_boot_cpu_number()) continue;
+        kern_return_t result=processor_start_reason(processors[n],REASON_SYSTEM,WAIT_FOR_START);
+        kprintf("A6PLTE CPU%u: processor_start -> %d, EL1/GIC mask %x, entry stage %u\n",
+            n,result,__atomic_load_n(&local_mask,__ATOMIC_ACQUIRE),a6_secondary_stage[n]);
+    }
+    kprintf("A6PLTE SMP: %u Cortex-A53 registered; local-ready mask %x\n",
+        count,__atomic_load_n(&local_mask,__ATOMIC_ACQUIRE));
+}
+#endif
