+	context->state[0] += a;
+	context->state[1] += b;
+	context->state[2] += c;
+	context->state[3] += d;
+
+	/* Zeroize sensitive information. */
+	x15 = x14 = x13 = x12 = x11 = x10 = x9 = x8 = 0;
+	x7 = x6 = x5 = x4 = x3 = x2 = x1 = x0 = 0;
+}
