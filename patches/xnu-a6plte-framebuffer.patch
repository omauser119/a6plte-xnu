+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef A6_BOOT_ABI_H
+#define A6_BOOT_ABI_H
+#include <stdint.h>
+#include <stddef.h>
+/* Exact LP64 layout of rel/xnu-12377 pexpert/pexpert/arm64/boot.h. */
+struct a6_boot_video { uint64_t base, display, stride, width, height, depth; };
+struct a6_boot_args {
+    uint16_t revision, version;
+    uint32_t pad0;
+    uint64_t virt_base, phys_base, mem_size, top_of_kernel_data;
+    struct a6_boot_video video;
+    uint32_t machine_type, pad1;
+    uint64_t device_tree;
+    uint32_t device_tree_length;
+    char command_line[1024];
+    uint32_t pad2;
+    uint64_t boot_flags, mem_size_actual;
+};
+_Static_assert(offsetof(struct a6_boot_args,video)==40,"Video ABI");
+_Static_assert(offsetof(struct a6_boot_args,device_tree)==96,"DeviceTree ABI");
+_Static_assert(offsetof(struct a6_boot_args,command_line)==108,"CommandLine ABI");
+_Static_assert(offsetof(struct a6_boot_args,boot_flags)==1136,"BootFlags ABI");
+_Static_assert(sizeof(struct a6_boot_args)==1152,"boot_args ABI");
+#endif
diff --git i/pexpert/arm/a6plte/early.c w/pexpert/arm/a6plte/early.c
new file mode 100644
index 0000000..b6278a2
--- /dev/null
+++ w/pexpert/arm/a6plte/early.c
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#if defined(A6PLTE)
+#include "fb.h"
+#include "boot_abi.h"
+#include "early.h"
+/* Called before XNU establishes any virtual mappings, on the boot CPU only. */
+unsigned char a6_xnu_early_stack[16384] __attribute__((aligned(16)));
+/* Physical framebuffer range consumed by start.s before enabling translation. */
+uint64_t a6_xnu_bootstrap_video[2];
+static struct a6_fb screen;
+static struct a6_boot_video video;
+static char pending[32768];
+static unsigned written;
+enum { DEFERRED, BOOTSTRAP, MAPPED };
+static int state;
+void a6_xnu_putc(char c) {
+    pending[written%sizeof(pending)]=c;
+    ++written;
+    if(state!=DEFERRED) a6_fb_putc(&screen,c);
+}
+void a6_xnu_puts(const char *s) { while(*s) a6_xnu_putc(*s++); }
+void a6_xnu_early_entry(const void *ptr) {
+    const struct a6_boot_args *args=ptr;
+    unsigned depth=args->video.depth & 255;
+    unsigned fmt=depth==24?A6_RGB888:depth==32?A6_XRGB8888:depth==16?A6_RGB565:0;
+    /* A6PLTE bridge uses unrotated packed RGB888; accept the other explicit depths too. */
+    if(args->revision!=2 || args->version!=2 || args->video.depth!=depth ||
+       args->video.width>8192 || args->video.height>8192 || args->video.stride>65536 ||
+       args->video.stride*args->video.height>32*1024*1024) return;
+    video=args->video;
+    if(a6_fb_init(&screen,video.base,video.stride*video.height,
+                  (uint32_t)video.width,(uint32_t)video.height,(uint32_t)video.stride,fmt)) return;
+    a6_xnu_bootstrap_video[0]=video.base;
+    a6_xnu_bootstrap_video[1]=video.stride*video.height;
+    state=BOOTSTRAP; written=0;
+    a6_fb_clear(&screen);
+    a6_xnu_puts("XNU 12377 / SM-A605FN\nstart_first_cpu: MMU OFF\nFramebuffer online. No UART.\n");
+}
+void a6_xnu_suspend_console(void) {
+    /* Stop physical stores before a caller removes the identity mapping. */
+    state=DEFERRED;
+    screen.base=0;
+}
+void a6_xnu_stage(unsigned stage) {
+    if(stage==1) a6_xnu_puts("start: exception vectors installed\n");
+    if(stage==2) a6_xnu_puts("start: bootstrap page tables ready\n");
+    if(stage==3) a6_xnu_puts("start: MMU enabled\n");
+}
+static void decimal(unsigned v) {
+    char digits[10]; unsigned n=0;
+    do { digits[n++]=(char)('0'+v%10); v/=10; } while(v);
+    while(n) a6_fb_putc(&screen,digits[--n]);
+}
+void a6_xnu_early_fault(uint64_t vector, uint64_t esr, uint64_t elr,
+                       uint64_t far, uint64_t sctlr, uint64_t descriptor) {
+    a6_xnu_puts("\nXNU EARLY EL1 EXCEPTION\nVECTOR: ");
+    if(state==DEFERRED) return;
+    a6_fb_hex(&screen,vector);
+    a6_fb_puts(&screen,"\nESR: "); a6_fb_hex(&screen,esr);
+    a6_fb_puts(&screen,"\nELR: "); a6_fb_hex(&screen,elr);
+    a6_fb_puts(&screen,"\nFAR: "); a6_fb_hex(&screen,far);
+    a6_fb_puts(&screen,"\nSCTLR: "); a6_fb_hex(&screen,sctlr);
+    if((sctlr&1) && (esr>>26)==0x3c && (esr&0xffff)==0xbffc && descriptor) {
+        /* rel/xnu-12377 mach_assert_hdr is packed to four-byte alignment. */
+        struct __attribute__((packed)) desc { uint32_t info; uint64_t file, text[3]; };
+        const struct desc *d=(const void *)(uintptr_t)descriptor;
+        unsigned kind=d->info&255;
+        if(kind<=3) {
+            a6_fb_puts(&screen,"\nXNU ASSERT: ");
+            a6_fb_puts(&screen,(const char *)(uintptr_t)d->file);
+            a6_fb_putc(&screen,':'); decimal(d->info>>8);
+            a6_fb_puts(&screen,"\n");
+            a6_fb_puts(&screen,(const char *)(uintptr_t)d->text[0]);
+            if(kind) {
+                a6_fb_putc(&screen,' '); a6_fb_puts(&screen,(const char *)(uintptr_t)d->text[1]);
+                a6_fb_putc(&screen,' '); a6_fb_puts(&screen,(const char *)(uintptr_t)d->text[2]);
+            }
+        }
+    }
+    a6_fb_puts(&screen,"\nCPU halted for diagnosis.\n");
+}
+int a6_xnu_map_console(uintptr_t (*map)(uintptr_t,uintptr_t)) {
+    if(state==MAPPED) return 1;
+    unsigned depth=video.depth&255;
+    unsigned fmt=depth==24?A6_RGB888:depth==32?A6_XRGB8888:depth==16?A6_RGB565:0;
+    if(!video.base || !video.stride || !video.height || !fmt) return 0;
+    uintptr_t va=map(video.base,video.stride*video.height);
+    if(!va || a6_fb_init(&screen,va,video.stride*video.height,(uint32_t)video.width,
+                        (uint32_t)video.height,(uint32_t)video.stride,fmt)) return 0;
+    state=MAPPED;
+    a6_fb_clear(&screen);
+    a6_fb_puts(&screen,"XNU / framebuffer mapped after arm_vm_init\n");
+    unsigned count=written>sizeof(pending)?sizeof(pending):written;
+    unsigned start=written-count;
+    for(unsigned i=0;i<count;++i) a6_fb_putc(&screen,pending[(start+i)%sizeof(pending)]);
+    return 1;
+}
+#endif
