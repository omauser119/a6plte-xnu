+    int (*flush)(void *);
+};
+struct a6_slice {
+    struct a6_blockdev *disk;
+    uint64_t first, count, attributes;
+    unsigned writable;
+};
+uint32_t a6_storage_crc32(const void *, size_t);
+int a6_gpt_userdata(struct a6_blockdev *, struct a6_slice *);
+int a6_slice_io(struct a6_slice *, int, uint64_t, uint32_t, void *);
+struct a6_hfs_volume {
+    uint64_t bytes;
+    uint32_t block_size, blocks, attributes;
+    uint16_t signature, version;
+};
+int a6_hfs_volume_check(struct a6_slice *, struct a6_hfs_volume *);
+
+/* Register accesses are injectable for host tests. No DMA or firmware calls. */
+struct a6_sdhci_ops {
+    uint32_t (*read)(void *, unsigned, unsigned);
+    void (*write)(void *, unsigned, unsigned, uint32_t);
+    uint64_t (*ticks)(void *);
+};
+struct a6_emmc {
+    const struct a6_sdhci_ops *ops;
