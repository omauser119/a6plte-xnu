+    if(notification!=MACH_PORT_NULL)releaseNotificationPort(notification);
+    if(owner)owner->release();if(lock)IOLockFree(lock);IOUserClient::free();
+}
+IOReturn A6HIDEventClient::registerNotificationPort(mach_port_t port,UInt32,UInt32) {
+    if (!lock) { if(port)releaseNotificationPort(port);return kIOReturnOffline; }
+    IOLockLock(lock);
+    if(closed) { IOLockUnlock(lock);if(port)releaseNotificationPort(port);return kIOReturnOffline; }
+    mach_port_t old=notification;notification=port;queue->setNotificationPort(port);
+    flushLocked();IOLockUnlock(lock);
+    if(old)releaseNotificationPort(old);return kIOReturnSuccess;
+}
+IOReturn A6HIDEventClient::clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory) {
+    if(!options || !memory || type>0)return kIOReturnBadArgument;
+    *memory=nullptr;*options=0;IOLockLock(lock);
+    auto descriptor=queue->getMemoryDescriptor();
+    if(!closed)*memory=descriptor;else if(descriptor)descriptor->release();IOLockUnlock(lock);
+    return *memory?kIOReturnSuccess:kIOReturnOffline;
+}
+IOReturn A6HIDEventClient::externalMethod(uint32_t selector,IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *,OSObject *,void *) {
+    if(!args || args->asyncWakePort || args->asyncReferenceCount || args->scalarOutputCount ||
+        args->structureInputDescriptor || selector>4)return kIOReturnBadArgument;
+    unsigned expected=selector<2?1:selector==2?2:selector==3?3:0;
+    if(args->scalarInputCount!=expected || (expected && !args->scalarInput) ||
+        args->structureInputSize>A6_HID_PACKET_MAX ||
+        (args->structureInputSize && !args->structureInput))return kIOReturnBadArgument;
+    if(selector<2) {
+        if(args->structureInputSize || args->structureOutputSize || args->structureOutputDescriptor)return kIOReturnBadArgument;
+        IOLockLock(lock);if(closed) { IOLockUnlock(lock);return kIOReturnOffline; }
+        opened=selector==0;IOLockUnlock(lock);
+        if(selector==0)owner->replay(this);return kIOReturnSuccess;
+    }
+    IOLockLock(lock);bool active=opened && !closed;IOLockUnlock(lock);
+    if(!active)return kIOReturnNotOpen;
+    if(selector==3)return kIOReturnUnsupported; /* No output HID elements. */
+    if(selector==4)return kIOReturnNotFound; /* No property-matching copy API yet. */
+    uint8_t data[A6_HID_PACKET_MAX];uint32_t n=owner->copyLast((uint32_t)args->scalarInput[0],data);
+    if(!n)return kIOReturnNotFound;
+    if(args->structureOutputDescriptor) {
+        if(args->structureOutputDescriptor->getLength()<n)return kIOReturnNoSpace;
+        if(args->structureOutputDescriptor->writeBytes(0,data,n)!=n)return kIOReturnVMError;
+        args->structureOutputDescriptorSize=n;
+    } else {
+        if(!args->structureOutput || args->structureOutputSize<n)return kIOReturnNoSpace;
+        memcpy(args->structureOutput,data,n);args->structureOutputSize=n;
+    }
+    return kIOReturnSuccess;
+}
+bool IOHIDEventService::start(IOService *provider) {
+    if(!IOService::start(provider) || !(lock=IOLockAlloc()))return false;
+    setProperty("Product",touch?"Samsung Galaxy A6+ Touchscreen":"Samsung Galaxy A6+ Buttons");
+    setProperty("Manufacturer","Samsung");setProperty("VendorID",0x04e8,32);
+    setProperty("ProductID",0xa605,32);setProperty("Built-In",true);
+    setProperty("Transport",touch?"I2C":"GPIO/SPMI");
+    setProperty("PrimaryUsagePage",touch?0x0d:0x0c,32);setProperty("PrimaryUsage",touch?4:1,32);
+    auto usage=OSDictionary::withCapacity(2);auto pairs=OSArray::withCapacity(1);
+    if(!usage || !pairs) {if(usage)usage->release();if(pairs)pairs->release();return false;}
+    auto page=OSNumber::withNumber(touch?0x0d:0x0c,32);auto value=OSNumber::withNumber(touch?4:1,32);
+    if(!page || !value) {if(page)page->release();if(value)value->release();usage->release();pairs->release();return false;}
+    usage->setObject("DeviceUsagePage",page);usage->setObject("DeviceUsage",value);
+    pairs->setObject(usage);setProperty("DeviceUsagePairs",pairs);
+    page->release();value->release();usage->release();pairs->release();
+    setProperty("IOUserClientClass","A6HIDEventClient");setProperty("A6PhysicalInput",true);
+    if(touch) { setProperty("DisplayIntegrated",true);setProperty("DisplayWidth",1080,32);setProperty("DisplayHeight",2220,32); }
+    return true;
+}
+void IOHIDEventService::free() { if(lock)IOLockFree(lock);IOService::free(); }
+bool IOHIDEventService::addClient(A6HIDEventClient *client) {
+    bool ok=false;IOLockLock(lock);
+    for(unsigned i=0;i<8;++i)if(!clients[i]) {clients[i]=client;client->retain();ok=true;break;}
+    IOLockUnlock(lock);return ok;
+}
+void IOHIDEventService::removeClient(A6HIDEventClient *client) {
+    bool found=false;IOLockLock(lock);
+    for(unsigned i=0;i<8;++i)if(clients[i]==client) {clients[i]=nullptr;found=true;break;}
+    IOLockUnlock(lock);if(found)client->release();
+}
+void IOHIDEventService::publish(unsigned slot,const void *data,uint32_t n) {
+    if(slot>=4 || !n || n>A6_HID_PACKET_MAX)return;
+    /* Serialize replay and live delivery in the same order. No user-memory
+     * access occurs under this sleeping mutex; client enqueue is kernel-only. */
+    IOLockLock(lock);memcpy(last[slot],data,n);lengths[slot]=n;
+    for(unsigned i=0;i<8;++i)if(clients[i])clients[i]->push(slot,data,n);
+    IOLockUnlock(lock);
+}
+void IOHIDEventService::flushClients() {
+    IOLockLock(lock);
+    for(unsigned i=0;i<8;++i)if(clients[i])clients[i]->flush();
+    IOLockUnlock(lock);
+}
+void IOHIDEventService::replay(A6HIDEventClient *client) {
+    IOLockLock(lock);
+    for(unsigned i=0;i<4;++i)if(lengths[i])client->push(i,last[i],lengths[i]);
+    IOLockUnlock(lock);
+}
+uint32_t IOHIDEventService::copyLast(uint32_t type,void *out) {
+    uint32_t n=0;IOLockLock(lock);
+    for(unsigned i=0;i<4;++i)if(lengths[i] && ((type==11 && touch) || (type==3 && !touch))) {
+        n=lengths[i];memcpy(out,last[i],n);break;
+    }
+    IOLockUnlock(lock);return n;
+}
+IOReturn IOHIDEventService::newUserClient(task_t task,void *security,UInt32 type,OSDictionary *props,IOUserClient **handler) {
+    if(!handler)return kIOReturnBadArgument;*handler=nullptr;
+    if(type!=0x65737563)return kIOReturnUnsupported; /* 'esuc', event-service connection */
+    /* This client exposes read-only physical events; it cannot inject events or
+     * access controller registers, framebuffer, storage, or kernel memory. */
+    A6HIDEventClient *client=new A6HIDEventClient;
+    if(!client)return kIOReturnNoMemory;
+    if(!client->initWithTask(task,security,type,props)) {client->release();return kIOReturnNoMemory;}
+    client->setProperty(kIOUserClientDefaultLockingKey,true);
+    if(!client->attach(this)) {client->release();return kIOReturnError;}
+    if(!client->start(this)) {client->detach(this);client->release();return kIOReturnNoResources;}
+    *handler=client;return kIOReturnSuccess;
+}
