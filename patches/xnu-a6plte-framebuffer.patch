+/* SPDX-License-Identifier: BSD-2-Clause */
+#include "A6PlatformServicesABI.h"
+
+int a6_surface_layout(uint64_t w,uint64_t h,uint64_t format,struct a6_surface_info *out) {
+    if (!out) return 0;
+    *out=(struct a6_surface_info){0};
+    if (!w || !h || w>4096 || h>4096 || (format!=A6_PIXEL_RGB888 && format!=A6_PIXEL_XRGB8888)) return 0;
+    uint32_t bpp=format==A6_PIXEL_RGB888?3:4;
+    uint64_t stride=(w*bpp+63)&~UINT64_C(63);
+    uint64_t size=(stride*h+4095)&~UINT64_C(4095);
+    if (size>A6_SURFACE_MAX_BYTES) return 0;
+    *out=(struct a6_surface_info){A6_SERVICE_ABI_VERSION,(uint32_t)w,(uint32_t)h,(uint32_t)stride,(uint32_t)format,0,size};
+    return 1;
+}
+int a6_display_rectangle(const struct a6_display_info *d,uint64_t x,uint64_t y,
+    uint64_t w,uint64_t h,uint64_t stride,uint64_t bytes) {
+    if (!d || !w || !h || x>=d->width || y>=d->height || w>d->width-x || h>d->height-y) return 0;
+    uint32_t bpp=d->pixel_format==A6_PIXEL_RGB888?3:d->pixel_format==A6_PIXEL_XRGB8888?4:0;
+    if (!bpp || d->bits_per_pixel!=bpp*8 || (uint64_t)d->stride< (uint64_t)d->width*bpp ||
+        d->size < (uint64_t)d->stride*d->height || stride<w*bpp || stride>65536) return 0;
+    return h<=bytes/stride;
+}
