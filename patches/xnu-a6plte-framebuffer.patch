diff --git c/osfmk/prng/a6plte_prng.c w/osfmk/prng/a6plte_prng.c
new file mode 100644
index 0000000..8633217
--- /dev/null
+++ w/osfmk/prng/a6plte_prng.c
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Install native XNU HMAC-SHA256 DRBG instances through the kernel PRNG API.
+ * The external corecrypto kext is absent on this board. No deterministic seeds,
+ * no timing-only seeding, and no bypass of random_cpu_init(). */
+#if A6PLTE
+#include <kern/debug.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <prng/random.h>
+#include <corecrypto/ccdrbg.h>
+#include <corecrypto/ccsha2.h>
+#include <corecrypto/cc.h>
+#include <pexpert/pexpert.h>
+
+static struct cckprng_ctx root;
+static struct {
+    lck_spin_t lock;
+    uint8_t state[CCKPRNG_DRBG_STATE_MAX_SIZE] __attribute__((aligned(16)));
+    bool initialized;
+} generators[8];
+static LCK_GRP_DECLARE(a6_prng_group,"a6plte kernel PRNG");
+static LCK_SPIN_DECLARE(root_lock,&a6_prng_group);
+static LCK_MTX_DECLARE(refresh_lock,&a6_prng_group);
+static cckprng_getentropy entropy_callback;
+static void *entropy_argument;
+static unsigned max_generators;
+static bool installed;
+static const struct ccdrbg_nisthmac_custom custom={.di=&ccsha256_ltc_di,.strictFIPS=0};
+static struct ccdrbg_state *root_state(void) { return (void *)root.drbg_state; }
+static void checked(int status) {
+    if(status!=CCDRBG_STATUS_OK)panic("A6PLTE kernel HMAC-DRBG error %d",status);
+}
+static void init_generator(__unused struct cckprng_ctx *context,unsigned cpu) {
+    if(cpu>=max_generators)panic("A6PLTE PRNG CPU index %u",cpu);
+    uint8_t seed[48];bool irq=ml_set_interrupts_enabled(FALSE);
+    lck_spin_lock(&root_lock);
+    checked(ccdrbg_generate(&root.drbg_info,root_state(),sizeof(seed),seed,0,NULL));
+    lck_spin_unlock(&root_lock);
+    lck_spin_lock(&generators[cpu].lock);
+    if(!generators[cpu].initialized) {
+        checked(ccdrbg_init(&root.drbg_info,(void *)generators[cpu].state,
+            32,seed,16,seed+32,sizeof(cpu),&cpu));
+        generators[cpu].initialized=true;
+    }
+    lck_spin_unlock(&generators[cpu].lock);
+    cc_clear(sizeof(seed),seed);ml_set_interrupts_enabled(irq);
+}
+static void initialize(struct cckprng_ctx *context,unsigned count,size_t seed_size,const void *seed,
+    size_t nonce_size,const void *nonce,cckprng_getentropy getentropy,void *argument) {
+    if(context!=&root || !count || count>8 || seed_size<32 || !seed)panic("A6PLTE invalid PRNG initialization");
+    ccdrbg_factory_nisthmac(&root.drbg_info,&custom);
+    if(root.drbg_info.size>CCKPRNG_DRBG_STATE_MAX_SIZE)panic("A6PLTE HMAC-DRBG state too large");
+    max_generators=count;entropy_callback=getentropy;entropy_argument=argument;
+    for(unsigned cpu=0;cpu<count;++cpu)lck_spin_init(&generators[cpu].lock,&a6_prng_group,LCK_ATTR_NULL);
+    static const char personalization[]="A6PLTE kernel PRNG root";
+    checked(ccdrbg_init(&root.drbg_info,root_state(),seed_size,seed,nonce_size,nonce,
+        sizeof(personalization)-1,personalization));
+}
+static void legacy_initialize(struct cckprng_ctx *context,size_t seed_size,const void *seed,
+    size_t nonce_size,const void *nonce,cckprng_getentropy getentropy,void *argument) {
+    initialize(context,8,seed_size,seed,nonce_size,nonce,getentropy,argument);
+}
+static void generate(__unused struct cckprng_ctx *context,unsigned cpu,size_t n,void *output) {
+    if(cpu>=max_generators || (n && !output))panic("A6PLTE invalid PRNG request");
+    bool irq=ml_set_interrupts_enabled(FALSE);lck_spin_lock(&generators[cpu].lock);
+    if(!generators[cpu].initialized)panic("A6PLTE uninitialized PRNG CPU%u",cpu);
+    uint8_t *bytes=output;
+    while(n) {
+        size_t chunk=n>CCKPRNG_MAX_REQUEST_SIZE?CCKPRNG_MAX_REQUEST_SIZE:n;
+        checked(ccdrbg_generate(&root.drbg_info,(void *)generators[cpu].state,chunk,bytes,0,NULL));
+        bytes+=chunk;n-=chunk;
+    }
+    lck_spin_unlock(&generators[cpu].lock);ml_set_interrupts_enabled(irq);
+}
+static void reseed(__unused struct cckprng_ctx *context,size_t n,const void *input) {
+    if(n<32 || !input)panic("A6PLTE invalid PRNG reseed");
+    uint8_t seed[48];bool irq=ml_set_interrupts_enabled(FALSE);lck_spin_lock(&root_lock);
+    checked(ccdrbg_reseed(&root.drbg_info,root_state(),n,input,0,NULL));
+    for(unsigned cpu=0;cpu<max_generators;++cpu) {
+        checked(ccdrbg_generate(&root.drbg_info,root_state(),sizeof(seed),seed,0,NULL));
+        lck_spin_lock(&generators[cpu].lock);
+        if(generators[cpu].initialized)
+            checked(ccdrbg_reseed(&root.drbg_info,(void *)generators[cpu].state,32,seed,16,seed+32));
+        lck_spin_unlock(&generators[cpu].lock);
+    }
+    lck_spin_unlock(&root_lock);cc_clear(sizeof(seed),seed);ml_set_interrupts_enabled(irq);
+}
+static void refresh(struct cckprng_ctx *context) {
+    /* entropy_provide uses a try-mutex. It must not run in an IRQ context. */
+    if(!ml_get_interrupts_enabled() || !entropy_callback || !lck_mtx_try_lock(&refresh_lock))return;
+    uint8_t entropy[64];size_t n=sizeof(entropy);
+    int32_t samples=entropy_callback(&n,entropy,entropy_argument);
+    if(samples>0 && n>=32 && n<=sizeof(entropy))reseed(context,n,entropy);
+    /* A rejected/empty health-test sample never replaces the boot-seeded state. */
+    cc_clear(sizeof(entropy),entropy);lck_mtx_unlock(&refresh_lock);
+}
+void a6_prng_install(void) {
+    if(installed)return;
+    static const struct cckprng_funcs functions={
+        .init=legacy_initialize,.init_with_getentropy=initialize,.initgen=init_generator,
+        .generate=generate,.reseed=reseed,.refresh=refresh,
+    };
+    register_and_init_prng(&root,&functions);installed=true;
+    kprintf("A6PLTE PRNG: native HMAC-SHA256, %u CPU generators available\n",max_generators);
+}
+#endif
