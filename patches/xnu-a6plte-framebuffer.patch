diff --git i/libkern/crypto/a6plte_kmem_rng.c w/libkern/crypto/a6plte_kmem_rng.c
new file mode 100644
index 0000000..ac446ff
--- /dev/null
+++ w/libkern/crypto/a6plte_kmem_rng.c
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#if defined(A6PLTE)
+#include "a6plte_kmem_rng.h"
+
+/* Scalar ChaCha20 block generator for kmem allocation decisions only.
+ * Its final four words are a 128-bit block counter, initially containing
+ * a random 96-bit prefix. This is not an encryption or general RNG API. */
+static uint32_t load32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1]<<8 |
+           (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24;
+}
+static uint32_t rotate(uint32_t v, unsigned n)
+{
+    return (v<<n) | (v>>(32-n));
+}
+static void quarter(uint32_t *a, uint32_t *b, uint32_t *c, uint32_t *d)
+{
+    *a+=*b; *d=rotate(*d^*a,16);
+    *c+=*d; *b=rotate(*b^*c,12);
+    *a+=*b; *d=rotate(*d^*a,8);
+    *c+=*d; *b=rotate(*b^*c,7);
+}
+static void refill(struct a6_kmem_rng *r)
+{
+    uint32_t x[16];
+    for(unsigned i=0;i<16;++i) x[i]=r->state[i];
+    for(unsigned round=0;round<10;++round) {
+        quarter(&x[0],&x[4],&x[8],&x[12]);
+        quarter(&x[1],&x[5],&x[9],&x[13]);
+        quarter(&x[2],&x[6],&x[10],&x[14]);
+        quarter(&x[3],&x[7],&x[11],&x[15]);
+        quarter(&x[0],&x[5],&x[10],&x[15]);
+        quarter(&x[1],&x[6],&x[11],&x[12]);
+        quarter(&x[2],&x[7],&x[8],&x[13]);
+        quarter(&x[3],&x[4],&x[9],&x[14]);
+    }
+    for(unsigned i=0;i<16;++i) {
+        uint32_t v=x[i]+r->state[i];
+        for(unsigned j=0;j<4;++j) r->block[4*i+j]=(uint8_t)(v>>(8*j));
+    }
+    for(unsigned i=12;i<16;++i) if(++r->state[i]) break;
+    r->used=0;
+}
+void a6_kmem_rng_init(struct a6_kmem_rng *r, const uint8_t seed[44])
+{
+    r->state[0]=0x61707865; r->state[1]=0x3320646e;
+    r->state[2]=0x79622d32; r->state[3]=0x6b206574;
+    for(unsigned i=0;i<8;++i) r->state[4+i]=load32(seed+4*i);
+    r->state[12]=0;
+    for(unsigned i=0;i<3;++i) r->state[13+i]=load32(seed+32+4*i);
+    for(unsigned i=0;i<64;++i) r->block[i]=0;
+    r->used=64;
+}
+void a6_kmem_rng_generate(struct a6_kmem_rng *r, void *buffer, size_t size)
+{
+    uint8_t *out=buffer;
+    while(size) {
+        if(r->used==64) refill(r);
+        size_t n=64-r->used;
+        if(n>size) n=size;
+        for(size_t i=0;i<n;++i) out[i]=r->block[r->used+i];
+        r->used+=(unsigned)n; out+=n; size-=n;
+    }
+}
+int a6_kmem_rng_uniform(struct a6_kmem_rng *r, uint64_t bound, uint64_t *out)
+{
+    if(!bound) return -1;
+    uint64_t threshold=(uint64_t)(-bound)%bound, value;
+    do {
+        uint8_t bytes[8];
+        a6_kmem_rng_generate(r,bytes,sizeof(bytes));
+        value=(uint64_t)load32(bytes) | (uint64_t)load32(bytes+4)<<32;
+    } while(value<threshold);
+    *out=value%bound;
+    return 0;
+}
+#endif
