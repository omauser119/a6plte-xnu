+class A6PLTEWatchdog : public IOWatchDogTimer {
+    OSDeclareDefaultStructors(A6PLTEWatchdog);
+    IOWorkLoop *loop=nullptr;
+    IOTimerEventSource *timer=nullptr;
+    IOLock *stateLock=nullptr;
+    uint64_t deadline=0,expirations=0;
+    static void expired(OSObject *,IOTimerEventSource *);
+public:
+    bool start(IOService *) APPLE_KEXT_OVERRIDE;
+    void stop(IOService *) APPLE_KEXT_OVERRIDE;
+    void free() APPLE_KEXT_OVERRIDE;
+    void setWatchDogTimer(UInt32) APPLE_KEXT_OVERRIDE;
+    IOReturn setProperties(OSObject *) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(A6PLTEWatchdog,IOWatchDogTimer);
+bool A6PLTEWatchdog::start(IOService *provider) {
+    stateLock=IOLockAlloc();loop=IOWorkLoop::workLoop();
+    if (!stateLock || !loop) return false;
+    timer=IOTimerEventSource::timerEventSource(this,expired);
+    if (!timer || loop->addEventSource(timer)!=kIOReturnSuccess) return false;
+    setName("IOWatchDogTimer");
+    setProperty("A6WatchdogLogOnly",true);
+    setProperty("A6HardwareResetEnabled",false);
+    if (!IOWatchDogTimer::start(provider)) return false;
+    IOLog("A6PLTE watchdog: log only; hardware reset disabled\n");
+    /* Exercise a real IOKit timer; expiry must leave the running PID1 intact. */
+    setProperty("A6BootTimerSelfTest",true);setWatchDogTimer(2);
+    ready(A6_READY_WATCHDOG);
+    return true;
+}
+void A6PLTEWatchdog::setWatchDogTimer(UInt32 seconds) {
+    if (!stateLock || !timer) return;
+    IOLockLock(stateLock);
+    timer->cancelTimeout();deadline=0;
+    setProperty("A6RequestedTimeoutSeconds",seconds,32);
+    setProperty("IOWatchDogEnabled",false); /* No reset watchdog is ever armed. */
+    setProperty("A6DiagnosticTimerArmed",seconds!=0);
+    if (seconds) {
+        clock_interval_to_deadline(seconds,kSecondScale,&deadline);
+        if (timer->wakeAtTime(deadline)!=kIOReturnSuccess) {
+            deadline=0;setProperty("A6DiagnosticTimerArmed",false);
+        }
+    }
+    IOLockUnlock(stateLock);
+}
+IOReturn A6PLTEWatchdog::setProperties(OSObject *properties) {
+    if (IOUserClient::clientHasPrivilege(current_task(),kIOClientPrivilegeAdministrator)!=kIOReturnSuccess)
+        return kIOReturnNotPrivileged;
+    OSNumber *number=OSDynamicCast(OSNumber,properties);
+    if (!number || number->unsigned64BitValue()>UINT32_MAX) return kIOReturnBadArgument;
+    setWatchDogTimer(number->unsigned32BitValue());return kIOReturnSuccess;
+}
+void A6PLTEWatchdog::expired(OSObject *target,__unused IOTimerEventSource *source) {
+    A6PLTEWatchdog *self=OSDynamicCast(A6PLTEWatchdog,target);
+    if (!self) return;
+    IOLockLock(self->stateLock);
+    if (self->deadline && mach_absolute_time()>=self->deadline) {
+        self->deadline=0;++self->expirations;
+        self->setProperty("A6DiagnosticTimerArmed",false);
+        self->setProperty("A6ExpirationCount",self->expirations,64);
+        ready(A6_WATCHDOG_TIMEOUT_OBSERVED);
+        IOLog("A6PLTE watchdog: timeout observed; continuing without reset\n");
+    }
+    IOLockUnlock(self->stateLock);
+}
+void A6PLTEWatchdog::stop(IOService *provider) {
+    IOWatchDogTimer::stop(provider);
+    if (timer && loop) loop->removeEventSource(timer);
+    IOService::stop(provider);
+}
+void A6PLTEWatchdog::free() {
+    if (timer) { timer->cancelTimeout();if (loop) loop->removeEventSource(timer);timer->release(); }
+    if (loop) loop->release();if (stateLock) IOLockFree(stateLock);
+    IOWatchDogTimer::free();
+}
