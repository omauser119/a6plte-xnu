+OSDefineMetaClassAndStructors(A6HIDEventClient,IOUserClient);
+bool A6HIDEventClient::start(IOService *provider) {
+    if (!IOUserClient::start(provider)) return false;
+    owner=OSDynamicCast(IOHIDEventService,provider);
+    lock=IOLockAlloc();queue=IOSharedDataQueue::withCapacity(16384);
+    if(owner)owner->retain();
+    if (!owner || !lock || !queue) return false;
+    registered=owner->addClient(this);return registered;
+}
+void A6HIDEventClient::flushLocked() {
+    if (!opened || closed || !queue) return;
+    for(unsigned i=0;i<4;++i)if(lengths[i] && queue->enqueue(pending[i],lengths[i]))lengths[i]=0;
+}
+void A6HIDEventClient::flush() { IOLockLock(lock);flushLocked();IOLockUnlock(lock); }
+void A6HIDEventClient::push(unsigned slot,const void *data,uint32_t n) {
+    if (slot>=4 || !n || n>A6_HID_PACKET_MAX) return;
