+    IOLockUnlock(lock);
+}
+IOReturn A6HIDEventClient::clientClose() {
+    if (lock) { IOLockLock(lock);closed=true;opened=false;IOLockUnlock(lock); }
+    if (registered && owner) { registered=false;owner->removeClient(this); }
+    terminate();return kIOReturnSuccess;
+}
+void A6HIDEventClient::stop(IOService *provider) {
+    if(lock) {IOLockLock(lock);closed=true;opened=false;IOLockUnlock(lock);}
+    if (registered && owner) { registered=false;owner->removeClient(this); }
+    IOUserClient::stop(provider);
+}
+void A6HIDEventClient::free() {
