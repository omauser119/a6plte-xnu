					qcom,micbias1-ext-cap;
					qcom,micbias2-ext-cap;
					qcom,mbhc-vthreshold-low = <0x96 0xe1 0x1c2 0x1f4 0x258>;
					qcom,mbhc-vthreshold-high = <0x96 0xe1 0x1c2 0x1f4 0x258>;
					vdd-cdc-io-supply = <0x72>;
					vdd-cdc-tx-rx-cx-supply = <0x31>;
					vdd-micbias-supply = <0x37>;
					phandle = <0xcf>;
				};

				regulators {
					compatible = "qcom,pm8950-regulators";

					s5 {
						qcom,saw-leader;
						regulator-min-microvolt = <0x61a80>;
						regulator-max-microvolt = <0x104028>;
