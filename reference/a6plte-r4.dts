					interrupt-controller;
					#interrupt-cells = <0x02>;
					status = "okay";
					phandle = <0x6d>;

					thm-adc-state {
						pins = "mpp4";
						function = "analog";
						input-enable;
						qcom,amux-route = <0x03>;
						bias-disable;
						phandle = <0x6c>;
