	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x02 0xff08 0x01 0x03 0xff08 0x01 0x04 0xff08 0x01 0x01 0xff08>;
	};

	aliases {
		mmc0 = "/soc@0/mmc@7824900";
		mmc1 = "/soc@0/mmc@7864900";
		i2c2 = "/soc@0/i2c@78b6000";
		i2c3 = "/soc@0/i2c@78b7000";
		i2c5 = "/soc@0/i2c@7af5000";
		i2c8 = "/soc@0/i2c@7af8000";
		i2c11 = "/i2c-gpio-1";
		i2c12 = "/i2c-gpio-2";
		i2c13 = "/i2c-gpio-3";
		i2c14 = "/i2c-gpio-4";
		i2c15 = "/i2c-gpio-5";
		i2c20 = "/soc@0/cci@1b0c000/i2c-bus@0";
		i2c21 = "/soc@0/cci@1b0c000/i2c-bus@1";
		serial0 = "/soc@0/serial@78af000";
	};

	mux-controller {
		compatible = "gpio-mux";
		mux-gpios = <0x6e 0x07 0x00>;
		pinctrl-names = "default";
		pinctrls = <0xe5>;
		#mux-control-cells = <0x00>;
		phandle = <0xe6>;
	};

	adc-mux {
		compatible = "io-channel-mux";
		io-channels = <0x6b 0x13>;
		io-channel-names = "parent";
		mux-controls = <0xe6>;
		channels = "AP_THM", "BATT_THM";
		#io-channel-cells = <0x01>;
		phandle = <0xe7>;
	};

	batt-thermal-sensor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0xe7 0x01>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <0xffffb1e0 0xa13a 0xffffc568 0x9f76 0xffffd8f0 0x9d3f 0xffffec78 0x9a92 0x00 0x979f 0x1388 0x9421 0x2710 0x906e 0x3a98 0x8c57 0x4e20 0x8832 0x61a8 0x83e7 0x7530 0x7fe7 0x88b8 0x7c2b 0x9c40 0x785f 0xafc8 0x7536 0xc350 0x724f 0xd6d8 0x6fbd 0xea60 0x6d82 0xfde8 0x6b81 0x11170 0x69e1 0x124f8 0x6882 0x13880 0x674f 0x14c08 0x665a 0x15f90 0x658d>;
		phandle = <0xe3>;
	};

	ap-thermal-sensor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0xe7 0x00>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <0xffffb1e0 0xa13a 0xffffc568 0x9f76 0xffffd8f0 0x9d3f 0xffffec78 0x9a92 0x00 0x979f 0x1388 0x9421 0x2710 0x906e 0x3a98 0x8c57 0x4e20 0x8832 0x61a8 0x83e7 0x7530 0x7fe7 0x88b8 0x7c2b 0x9c40 0x785f 0xafc8 0x7536 0xc350 0x724f 0xd6d8 0x6fbd 0xea60 0x6d82 0xfde8 0x6b81 0x11170 0x69e1 0x124f8 0x6882 0x13880 0x674f 0x14c08 0x665a 0x15f90 0x658d>;
		phandle = <0xe0>;
	};

	pa-thermal-sensor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0x6b 0x36>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <0xffffb1e0 0xa13a 0xffffc568 0x9f76 0xffffd8f0 0x9d3f 0xffffec78 0x9a92 0x00 0x979f 0x1388 0x9421 0x2710 0x906e 0x3a98 0x8c57 0x4e20 0x8832 0x61a8 0x83e7 0x7530 0x7fe7 0x88b8 0x7c2b 0x9c40 0x785f 0xafc8 0x7536 0xc350 0x724f 0xd6d8 0x6fbd 0xea60 0x6d82 0xfde8 0x6b81 0x11170 0x69e1 0x124f8 0x6882 0x13880 0x674f 0x14c08 0x665a 0x15f90 0x658d>;
		phandle = <0xe2>;
	};

	battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <0x3567e0>;
		charge-term-current-microamp = <0x493e0>;
		constant-charge-current-max-microamp = <0x1b7740>;
		constant-charge-voltage-max-microvolt = <0x426030>;
		voltage-max-design-microvolt = <0x426030>;
		voltage-min-design-microvolt = <0x30d400>;
		alert-celsius = <0x05 0x2a>;
		operating-range-celsius = <0x00 0x32>;
		phandle = <0xb5>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-volume-up {
			label = "Volume Up";
			gpios = <0x38 0x55 0x01>;
			linux,code = <0x73>;
			wakeup-source;
		};

		event-lid {
			label = "Hall Effect Sensor";
			gpios = <0x38 0x2c 0x01>;
			linux,input-type = <0x05>;
			linux,code = <0x00>;
			linux,can-disable;
		};
	};

	i2c-gpio-1 {
		compatible = "i2c-gpio";
		sda-gpios = <0x38 0x10 0x06>;
		scl-gpios = <0x38 0x11 0x06>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		light-proximity-sensor@60 {
			compatible = "capella,cm36658";
			reg = <0x60>;
			interrupts-extended = <0x38 0x2b 0x02>;
			vdd-supply = <0xe8>;
			vled-supply = <0xe9>;
		};
	};

	i2c-gpio-2 {
		compatible = "i2c-gpio";
		sda-gpios = <0x38 0x15 0x06>;
		scl-gpios = <0x38 0x14 0x06>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		gpio@20 {
			compatible = "nxp,pcal6416";
			reg = <0x20>;
			reset-gpios = <0x38 0x21 0x01>;
			vcc-supply = <0x72>;
			gpio-controller;
			#gpio-cells = <0x02>;
			phandle = <0xee>;
		};
	};

	i2c-gpio-3 {
		compatible = "i2c-gpio";
		sda-gpios = <0x38 0x27 0x06>;
		scl-gpios = <0x38 0x26 0x06>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		battery-gauge@71 {
			compatible = "siliconmitus,sm5708-battery";
			reg = <0x71>;
			interrupts-extended = <0x38 0x3e 0x00>;
			pinctrl-0 = <0xea>;
			pinctrl-names = "default";
			power-supplies = <0xeb>;
			monitored-battery = <0xb5>;
		};
	};

	i2c-gpio-4 {
		compatible = "i2c-gpio";
		sda-gpios = <0x38 0x40 0x06>;
		scl-gpios = <0x38 0x41 0x06>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		accelerometer@6b {
			compatible = "st,lsm6dsl";
			reg = <0x6b>;
			interrupts-extended = <0x38 0x2a 0x01>;
			mount-matrix = "-1", "0", "0", "0", "-1", "0", "0", "0", "-1";
			pinctrl-0 = <0xec>;
			pinctrl-names = "default";
			vdd-supply = <0xe8>;
		};
	};

	i2c-gpio-5 {
		compatible = "i2c-gpio";
		sda-gpios = <0x38 0x83 0x06>;
		scl-gpios = <0x38 0x80 0x06>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		grip-sensor@20 {
			compatible = "abov,a96t3x6";
			reg = <0x20>;
			interrupts-extended = <0x38 0x56 0x00>;
			vdd-supply = <0xed>;
		};
	};

	vibrator {
		compatible = "gpio-vibrator";
		enable-gpios = <0x38 0x84 0x00>;
	};

	vreg-vbat {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-max-microvolt = <0x387520>;
		regulator-min-microvolt = <0x387520>;
		regulator-name = "VBAT";
		phandle = <0x2f>;
	};

	vreg-panel-vdd-vci {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x38 0x23 0x00>;
		regulator-boot-on;
		regulator-max-microvolt = <0x2dc6c0>;
		regulator-min-microvolt = <0x2dc6c0>;
		regulator-name = "panel_vdd_vci";
		startup-delay-us = <0xc8>;
		vin-supply = <0x2f>;
		phandle = <0x4c>;
	};

	vreg-panel-vddr {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x38 0x5d 0x00>;
		regulator-boot-on;
		regulator-max-microvolt = <0x16e360>;
		regulator-min-microvolt = <0x16e360>;
		regulator-name = "panel_vddr";
		startup-delay-us = <0xc8>;
		vin-supply = <0x31>;
		phandle = <0x4d>;
	};

	vreg-ts-avdd {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x38 0x8b 0x00>;
		regulator-boot-on;
		regulator-max-microvolt = <0x325aa0>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "ts_avdd";
		startup-delay-us = <0xc8>;
		vin-supply = <0x2f>;
		phandle = <0x95>;
	};

	vreg-ts-vdd {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x38 0x8b 0x00>;
		regulator-boot-on;
		regulator-max-microvolt = <0x1b7740>;
